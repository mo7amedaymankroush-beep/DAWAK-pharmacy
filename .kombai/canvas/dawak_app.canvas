      },
      "html": "<div class=\"dawak\" data-kid=\"1\" data-name=\"page root container (RTL Arabic)\" dir=\"rtl\" lang=\"ar\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n.dawak{--ink:#122E29;--ink2:#3F5B54;--muted:#6C837C;--line:#E1EAE6;--line2:#D2E0DA;--brand:#0C5449;--brand-deep:#093B34;--accent:#12836B;--mint:#EAF4F0;--mint2:#F3F9F6;--amber:#E2952A;font-family:'Cairo',system-ui,-apple-system,sans-serif;background:linear-gradient(180deg,#EDF6F1 0,#F4F7F5 280px);color:var(--ink);min-height:100vh;padding-bottom:10px;-webkit-font-smoothing:antialiased}\n.dawak *{box-sizing:border-box}\n:where(.dawak) button,:where(.dawak) input{font:inherit;color:inherit}\n:where(.dawak) button{border:0;background:none;cursor:pointer}\n.dawak a{color:inherit;text-decoration:none}\n.ico{display:inline-block;font-style:normal;font-weight:400;line-height:1;font-size:16px}\n.page{max-width:1356px;margin:0 auto;padding:16px 42px 0}\n\n/* top bar */\n.topbar{height:82px;display:flex;align-items:center;gap:24px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:0 20px;box-shadow:0 6px 20px rgba(9,59,52,.05)}\n.brand{display:flex;align-items:center;gap:10px;flex:none}\n.brand img{width:44px;height:44px;border-radius:10px;object-fit:contain;mix-blend-mode:multiply}\n.brand-txt{display:grid;gap:1px;line-height:1.15}\n.brand-txt b{font-family:'Cairo',sans-serif;font-size:18px;font-weight:800;color:var(--brand-deep)}\n.brand-txt span{font-size:8.5px;font-weight:700;letter-spacing:1.5px;color:var(--muted)}\n.nav{flex:1;display:flex;align-items:center;justify-content:center;gap:20px}\n.nav a{font-size:12.5px;font-weight:700;color:#4D655F;padding:10px 2px;position:relative;white-space:nowrap}\n.nav a.on{color:var(--brand-deep)}\n.nav a.on::after{content:\"\";position:absolute;inset-inline:0;bottom:0;height:2px;border-radius:2px;background:var(--accent)}\n.acts{display:flex;gap:8px;flex:none}\n.btn-cart{height:40px;padding:0 14px;border:1px solid var(--line2);border-radius:10px;background:#fff;color:var(--brand);display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800}\n.btn-cart .ico{font-size:16px}\n.btn-account{height:40px;padding:0 14px;border-radius:10px;background:var(--brand);color:#fff;display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800}\n\n/* search console */\n.search-panel{margin-top:14px;background:#fff;border:1px solid var(--line);border-radius:18px;padding:16px 18px 18px;box-shadow:0 10px 26px rgba(9,59,52,.04)}\n.sp-head{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:14px}\n.sp-head h1{font-size:23px;font-weight:800;color:var(--brand-deep);margin:0;letter-spacing:-.2px}\n.rx{display:inline-flex;align-items:center;gap:8px;height:38px;padding:0 12px;border:1px dashed var(--line2);border-radius:10px;background:#fff;color:var(--brand);font-size:12px;font-weight:800}\n.rx .ico{font-size:16px;color:var(--amber)}\n.rx em{font-style:normal;font-size:10.5px;font-weight:700;color:var(--muted);border-inline-start:1px solid var(--line);padding-inline-start:9px}\n.sp-row{display:grid;grid-template-columns:minmax(0,1fr) 146px 146px 168px 48px 108px;gap:10px;align-items:stretch}\n.field{display:flex;align-items:center;gap:8px;height:56px;border:1px solid var(--line2);border-radius:12px;padding:0 12px;background:#fff;min-width:0}\n.field.q .ico{font-size:17px;color:#7E958E;flex:none}\n.field.q input{border:0;outline:0;background:transparent;flex:1;min-width:0;font-size:12.5px;font-weight:600;color:var(--ink)}\n.field.q input::placeholder{color:#96A8A2;font-weight:600}\n.field.sel{cursor:pointer}\n.fld{display:grid;gap:0;flex:1;min-width:0;line-height:1.35}\n.fld-t{font-size:9.5px;font-weight:700;color:var(--muted)}\n.fld-v{font-size:12.5px;font-weight:800;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.field.sel .ico{font-size:14px;color:#8C9F99;flex:none}\n.loc-btn{height:56px;border:1px solid var(--line2);border-radius:12px;background:#fff;color:var(--brand);display:grid;place-items:center}\n.loc-btn .ico{font-size:18px}\n.btn-search{height:56px;border-radius:12px;background:var(--brand);color:#fff;font-size:13.5px;font-weight:800;display:flex;align-items:center;justify-content:center}\n\n/* categories */\n.cats{margin-top:18px;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}\n.cat{height:76px;display:flex;align-items:center;justify-content:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:14px;color:#3F5B54;font-size:13px;font-weight:800}\n.cat .ic{width:34px;height:34px;border-radius:10px;background:var(--mint2);color:var(--brand);display:grid;place-items:center;font-size:18px;flex:none}\n.cat.on{background:var(--mint);border-color:#BCDFD3;color:var(--brand-deep)}\n.cat.on .ic{background:#fff}\n\n/* catalog */\n.sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:22px 0 12px}\n.sec-head h2{font-size:18px;font-weight:800;color:var(--brand-deep);margin:0}\n.sec-head span{font-size:11.5px;font-weight:700;color:var(--muted)}\n.grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:20px}\n.card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;min-height:190px}\n.thumb{width:34px;height:34px;border-radius:9px;background:var(--mint2);color:var(--brand);display:grid;place-items:center;font-size:17px}\n.card h3{font-size:14.5px;font-weight:800;color:var(--brand-deep);margin:12px 0 4px}\n.card .ing{font-size:11px;font-weight:700;color:#4E6A63;margin:0;line-height:1.6;min-height:34px}\n.card .pack{font-size:11px;font-weight:600;color:var(--muted);margin:0}\n.price-row{margin-top:auto;display:flex;align-items:baseline;gap:4px;padding-top:12px}\n.price{font-size:16px;font-weight:800;color:var(--brand-deep);font-variant-numeric:tabular-nums}\n.cur{font-size:10.5px;font-weight:700;color:var(--muted)}\n.card-actions{display:flex;align-items:center;gap:8px;margin-top:10px}\n.add{flex:1;height:34px;border:1px solid #CBE1D8;border-radius:8px;background:var(--mint2);color:var(--brand);font-size:11.5px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap}\n.add .ico{font-size:14px}\n.det{border:0;background:none;color:#55716A;font-size:11.5px;font-weight:800;padding:0 2px;white-space:nowrap}\n.more-wrap{display:flex;justify-content:center;margin-top:18px}\n.more{height:40px;padding:0 22px;border:1px solid var(--line2);border-radius:10px;background:#fff;color:var(--brand);font-size:12.5px;font-weight:800;display:inline-flex;align-items:center;gap:8px}\n.more .ico{font-size:15px}\n\n/* footer */\n.foot{margin-top:26px;border-top:1px solid var(--line);padding:16px 0 20px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:11.5px;font-weight:700;color:var(--muted)}\n.links{display:flex;gap:18px}\n.links a{color:#4E6A63}\n</style>\n<div class=\"page\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n<header class=\"topbar\" data-kid=\"1-1-1\" data-name=\"top navigation bar\">\n<div class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo block\">\n<img alt=\"شعار دواك\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-txt\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text block\"><b data-kid=\"1-1-1-1-2-1\" data-name='brand name \"Dawak\" text'>دواك</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline text\">DAWAK PHARMACY</span></span>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n<a class=\"on\" data-kid=\"1-1-1-2-1\" data-name=\"nav link - home (active)\" href=\"#\">الرئيسية</a>\n<a data-kid=\"1-1-1-2-2\" data-name=\"nav link - products\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link - pharmacist consultation\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link - FAQ\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link - contact us\" href=\"#\">اتصل بنا</a>\n<a data-kid=\"1-1-1-2-6\" data-name=\"nav link - my bookings\" href=\"#\">حجوزاتي</a>\n<a data-kid=\"1-1-1-2-7\" data-name=\"nav link - my orders\" href=\"#\">طلباتي</a>\n</nav>\n<div class=\"acts\" data-kid=\"1-1-1-3\" data-name=\"actions button group\">\n<button class=\"btn-cart\" data-kid=\"1-1-1-3-1\" data-name=\"shopping cart button\"><i class=\"ico icon-shopping-cart\" data-kid=\"1-1-1-3-1-1\" data-name=\"shopping cart icon\"></i><span data-kid=\"1-1-1-3-1-2\" data-name=\"cart button label with item count\">العربة (2)</span></button>\n<button class=\"btn-account\" data-kid=\"1-1-1-3-2\" data-name=\"account button\"><i class=\"ico icon-user-round\" data-kid=\"1-1-1-3-2-1\" data-name=\"user account icon\"></i><span data-kid=\"1-1-1-3-2-2\" data-name=\"account button label\">حسابي</span></button>\n</div>\n</header>\n<section class=\"search-panel\" data-kid=\"1-1-2\" data-name=\"medicine search panel\">\n<div class=\"sp-head\" data-kid=\"1-1-2-1\" data-name=\"search panel header\">\n<h1 data-kid=\"1-1-2-1-1\" data-name=\"search panel heading\">البحث عن دواء</h1>\n<button class=\"rx\" data-kid=\"1-1-2-1-2\" data-name=\"upload prescription button\"><i class=\"ico icon-upload\" data-kid=\"1-1-2-1-2-1\" data-name=\"upload icon\"></i><span data-kid=\"1-1-2-1-2-2\" data-name=\"prescription upload button label\">عندك روشتة؟ ارفع صورة أو PDF</span><em data-kid=\"1-1-2-1-2-3\" data-name=\"file choice label\">اختيار ملف</em></button>\n</div>\n<div class=\"sp-row\" data-kid=\"1-1-2-2\" data-name=\"search input row\">\n<label class=\"field q\" data-kid=\"1-1-2-2-1\" data-name=\"drug search input field\">\n<i class=\"ico icon-search\" data-kid=\"1-1-2-2-1-1\" data-name=\"search icon\"></i>\n<input data-kid=\"1-1-2-2-1-2\" data-name=\"drug name search text input\" placeholder=\"اكتب اسم الدواء أو المادة الفعالة\"/>\n</label>\n<div class=\"field sel\" data-kid=\"1-1-2-2-2\" data-name=\"province selector field\">\n<span class=\"fld\" data-kid=\"1-1-2-2-2-1\" data-name=\"province label and value\"><span class=\"fld-t\" data-kid=\"1-1-2-2-2-1-1\" data-name=\"province field label\">المحافظة</span><span class=\"fld-v\" data-kid=\"1-1-2-2-2-1-2\" data-name=\"province selected value\">القاهرة</span></span>\n<i class=\"ico icon-chevron-down\" data-kid=\"1-1-2-2-2-2\" data-name=\"province dropdown chevron icon\"></i>\n</div>\n<div class=\"field sel\" data-kid=\"1-1-2-2-3\" data-name=\"city selector field\">\n<span class=\"fld\" data-kid=\"1-1-2-2-3-1\" data-name=\"city label and value\"><span class=\"fld-t\" data-kid=\"1-1-2-2-3-1-1\" data-name=\"city field label\">المدينة</span><span class=\"fld-v\" data-kid=\"1-1-2-2-3-1-2\" data-name=\"city selected value\">مدينة نصر</span></span>\n<i class=\"ico icon-chevron-down\" data-kid=\"1-1-2-2-3-2\" data-name=\"city dropdown chevron icon\"></i>\n</div>\n<div class=\"field sel\" data-kid=\"1-1-2-2-4\" data-name=\"district selector field\">\n<span class=\"fld\" data-kid=\"1-1-2-2-4-1\" data-name=\"district label and value\"><span class=\"fld-t\" data-kid=\"1-1-2-2-4-1-1\" data-name=\"district field label\">المنطقة</span><span class=\"fld-v\" data-kid=\"1-1-2-2-4-1-2\" data-name=\"district selected value\">الحي السابع</span></span>\n<i class=\"ico icon-chevron-down\" data-kid=\"1-1-2-2-4-2\" data-name=\"district dropdown chevron icon\"></i>\n</div>\n<button aria-label=\"استخدم موقعي الحالي\" class=\"loc-btn\" data-kid=\"1-1-2-2-5\" data-name=\"use my location button\"><i class=\"ico icon-crosshair\" data-kid=\"1-1-2-2-5-1\" data-name=\"crosshair location icon\"></i></button>\n<button class=\"btn-search\" data-kid=\"1-1-2-2-6\" data-name=\"search submit button\">ابحث</button>\n</div>\n</section>\n<nav class=\"cats\" data-kid=\"1-1-3\" data-name=\"category filter navigation\">\n<button class=\"cat on\" data-kid=\"1-1-3-1\" data-name=\"category button - medicines (active)\"><span class=\"ic\" data-kid=\"1-1-3-1-1\" data-name=\"category icon badge\"><i class=\"ico icon-pill\" data-kid=\"1-1-3-1-1-1\" data-name=\"pill category icon\"></i></span>الأدوية</button>\n<button class=\"cat\" data-kid=\"1-1-3-2\" data-name=\"category button - skincare\"><span class=\"ic\" data-kid=\"1-1-3-2-1\" data-name=\"category icon badge\"><i class=\"ico icon-sparkles\" data-kid=\"1-1-3-2-1-1\" data-name=\"sparkles skincare icon\"></i></span>عناية بالبشرة</button>\n<button class=\"cat\" data-kid=\"1-1-3-3\" data-name=\"category button - vitamins\"><span class=\"ic\" data-kid=\"1-1-3-3-1\" data-name=\"category icon badge\"><i class=\"ico icon-heart-pulse\" data-kid=\"1-1-3-3-1-1\" data-name=\"heart pulse vitamin icon\"></i></span>الفيتامينات</button>\n<button class=\"cat\" data-kid=\"1-1-3-4\" data-name=\"category button - medical devices\"><span class=\"ic\" data-kid=\"1-1-3-4-1\" data-name=\"category icon badge\"><i class=\"ico icon-stethoscope\" data-kid=\"1-1-3-4-1-1\" data-name=\"stethoscope device icon\"></i></span>أجهزة طبية</button>\n<button class=\"cat\" data-kid=\"1-1-3-5\" data-name=\"category button - first aid\"><span class=\"ic\" data-kid=\"1-1-3-5-1\" data-name=\"category icon badge\"><i class=\"ico icon-bandage\" data-kid=\"1-1-3-5-1-1\" data-name=\"bandage first aid icon\"></i></span>إسعافات أولية</button>\n</nav>\n<section data-kid=\"1-1-4\" data-name=\"drug catalog section\">\n<div class=\"sec-head\" data-kid=\"1-1-4-1\" data-name=\"section header with product count\">\n<h2 data-kid=\"1-1-4-1-1\" data-name='section title \"Medicines\"'>الأدوية</h2>\n<span data-kid=\"1-1-4-1-2\" data-name=\"product count label\">10 منتجات</span>\n</div>\n<div class=\"grid\" data-kid=\"1-1-4-2\" data-name=\"drug products grid\">\n<article class=\"card\" data-kid=\"1-1-4-2-1\" data-name=\"drug product card (Panadol)\">\n<span class=\"thumb\" data-kid=\"1-1-4-2-1-1\" data-name=\"product thumbnail icon badge\"><i class=\"ico icon-pill\" data-kid=\"1-1-4-2-1-1-1\" data-name=\"pill product icon\"></i></span>\n<h3 data-kid=\"1-1-4-2-1-2\" data-name=\"product name title\">بانادول</h3>\n<p class=\"ing\" data-kid=\"1-1-4-2-1-3\" data-name=\"active ingredient description\">باراسيتامول · 500 مج</p>\n<p class=\"pack\" data-kid=\"1-1-4-2-1-4\" data-name=\"package quantity text\">عبوة 20 قرص</p>\n<div class=\"price-row\" data-kid=\"1-1-4-2-1-5\" data-name=\"product price row\"><span class=\"price\" data-kid=\"1-1-4-2-1-5-1\" data-name=\"product price amount\">35</span><span class=\"cur\" data-kid=\"1-1-4-2-1-5-2\" data-name=\"currency label\">ج.م</span></div>\n<div class=\"card-actions\" data-kid=\"1-1-4-2-1-6\" data-name=\"product action buttons\"><button class=\"add\" data-kid=\"1-1-4-2-1-6-1\" data-name=\"add to cart button\"><i class=\"ico icon-plus\" data-kid=\"1-1-4-2-1-6-1-1\" data-name=\"plus icon\"></i>إضافة للعربة</button><button class=\"det\" data-kid=\"1-1-4-2-1-6-2\" data-name=\"details link button\">التفاصيل</button></div>\n</article>\n<article class=\"card\" data-kid=\"1-1-4-2-2\" data-name=\"drug product card (Abamol)\">\n<span class=\"thumb\" data-kid=\"1-1-4-2-2-1\" data-name=\"product thumbnail icon badge\"><i class=\"ico icon-pill\" data-kid=\"1-1-4-2-2-1-1\" data-name=\"pill product icon\"></i></span>\n<h3 data-kid=\"1-1-4-2-2-2\" data-name=\"product name title\">أبيمول</h3>\n<p class=\"ing\" data-kid=\"1-1-4-2-2-3\" data-name=\"active ingredient description\">باراسيتامول · 500 مج</p>\n<p class=\"pack\" data-kid=\"1-1-4-2-2-4\" data-name=\"package quantity text\">عبوة 20 قرص</p>\n<div class=\"price-row\" data-kid=\"1-1-4-2-2-5\" data-name=\"product price row\"><span class=\"price\" data-kid=\"1-1-4-2-2-5-1\" data-name=\"product price amount\">28</span><span class=\"cur\" data-kid=\"1-1-4-2-2-5-2\" data-name=\"currency label\">ج.م</span></div>\n<div class=\"card-actions\" data-kid=\"1-1-4-2-2-6\" data-name=\"product action buttons\"><button class=\"add\" data-kid=\"1-1-4-2-2-6-1\" data-name=\"add to cart button\"><i class=\"ico icon-plus\" data-kid=\"1-1-4-2-2-6-1-1\" data-name=\"plus icon\"></i>إضافة للعربة</button><button class=\"det\" data-kid=\"1-1-4-2-2-6-2\" data-name=\"details link button\">التفاصيل</button></div>\n</article>\n<article class=\"card\" data-kid=\"1-1-4-2-3\" data-name=\"drug product card (Congestal)\">\n<span class=\"thumb\" data-kid=\"1-1-4-2-3-1\" data-name=\"product thumbnail icon badge\"><i class=\"ico icon-pill\" data-kid=\"1-1-4-2-3-1-1\" data-name=\"pill product icon\"></i></span>\n<h3 data-kid=\"1-1-4-2-3-2\" data-name=\"product name title\">كونجستال</h3>\n<p class=\"ing\" data-kid=\"1-1-4-2-3-3\" data-name=\"active ingredient description\">تركيبة متعددة المكونات · أقراص</p>\n<p class=\"pack\" data-kid=\"1-1-4-2-3-4\" data-name=\"package quantity text\">عبوة أقراص</p>\n<div class=\"price-row\" data-kid=\"1-1-4-2-3-5\" data-name=\"product price row\"><span class=\"price\" data-kid=\"1-1-4-2-3-5-1\" data-name=\"product price amount\">42</span><span class=\"cur\" data-kid=\"1-1-4-2-3-5-2\" data-name=\"currency label\">ج.م</span></div>\n<div class=\"card-actions\" data-kid=\"1-1-4-2-3-6\" data-name=\"product action buttons\"><button class=\"add\" data-kid=\"1-1-4-2-3-6-1\" data-name=\"add to cart button\"><i class=\"ico icon-plus\" data-kid=\"1-1-4-2-3-6-1-1\" data-name=\"plus icon\"></i>إضافة للعربة</button><button class=\"det\" data-kid=\"1-1-4-2-3-6-2\" data-name=\"details link button\">التفاصيل</button></div>\n</article>\n<article class=\"card\" data-kid=\"1-1-4-2-4\" data-name=\"drug product card (Brufen)\">\n<span class=\"thumb\" data-kid=\"1-1-4-2-4-1\" data-name=\"product thumbnail icon badge\"><i class=\"ico icon-pill\" data-kid=\"1-1-4-2-4-1-1\" data-name=\"pill product icon\"></i></span>\n<h3 data-kid=\"1-1-4-2-4-2\" data-name=\"product name title\">بروفين</h3>\n<p class=\"ing\" data-kid=\"1-1-4-2-4-3\" data-name=\"active ingredient description\">إيبوبروفين · 400 مج</p>\n<p class=\"pack\" data-kid=\"1-1-4-2-4-4\" data-name=\"package quantity text\">عبوة أقراص</p>\n<div class=\"price-row\" data-kid=\"1-1-4-2-4-5\" data-name=\"product price row\"><span class=\"price\" data-kid=\"1-1-4-2-4-5-1\" data-name=\"product price amount\">45</span><span class=\"cur\" data-kid=\"1-1-4-2-4-5-2\" data-name=\"currency label\">ج.م</span></div>\n<div class=\"card-actions\" data-kid=\"1-1-4-2-4-6\" data-name=\"product action buttons\"><button class=\"add\" data-kid=\"1-1-4-2-4-6-1\" data-name=\"add to cart button\"><i class=\"ico icon-plus\" data-kid=\"1-1-4-2-4-6-1-1\" data-name=\"plus icon\"></i>إضافة للعربة</button><button class=\"det\" data-kid=\"1-1-4-2-4-6-2\" data-name=\"details link button\">التفاصيل</button></div>\n</article>\n<article class=\"card\" data-kid=\"1-1-4-2-5\" data-name=\"drug product card (Zyrtec)\">\n<span class=\"thumb\" data-kid=\"1-1-4-2-5-1\" data-name=\"product thumbnail icon badge\"><i class=\"ico icon-pill\" data-kid=\"1-1-4-2-5-1-1\" data-name=\"pill product icon\"></i></span>\n<h3 data-kid=\"1-1-4-2-5-2\" data-name=\"product name title\">زيرتك</h3>\n<p class=\"ing\" data-kid=\"1-1-4-2-5-3\" data-name=\"active ingredient description\">سيتريزين · 10 مج</p>\n<p class=\"pack\" data-kid=\"1-1-4-2-5-4\" data-name=\"package quantity text\">عبوة أقراص</p>\n<div class=\"price-row\" data-kid=\"1-1-4-2-5-5\" data-name=\"product price row\"><span class=\"price\" data-kid=\"1-1-4-2-5-5-1\" data-name=\"product price amount\">55</span><span class=\"cur\" data-kid=\"1-1-4-2-5-5-2\" data-name=\"currency label\">ج.م</span></div>\n<div class=\"card-actions\" data-kid=\"1-1-4-2-5-6\" data-name=\"product action buttons\"><button class=\"add\" data-kid=\"1-1-4-2-5-6-1\" data-name=\"add to cart button\"><i class=\"ico icon-plus\" data-kid=\"1-1-4-2-5-6-1-1\" data-name=\"plus icon\"></i>إضافة للعربة</button><button class=\"det\" data-kid=\"1-1-4-2-5-6-2\" data-name=\"details link button\">التفاصيل</button></div>\n</article>\n</div>\n<div class=\"more-wrap\" data-kid=\"1-1-4-3\" data-name=\"show more button wrapper\"><button class=\"more\" data-kid=\"1-1-4-3-1\" data-name=\"show more products button\">عرض المزيد<i class=\"ico icon-chevron-down\" data-kid=\"1-1-4-3-1-1\" data-name=\"chevron down icon\"></i></button></div>\n</section>\n<footer class=\"foot\" data-kid=\"1-1-5\" data-name=\"footer bar\">\n<span data-kid=\"1-1-5-1\" data-name=\"footer tagline text\">دواك — صيدليتك أونلاين</span>\n<span class=\"links\" data-kid=\"1-1-5-2\" data-name=\"footer links group\"><a data-kid=\"1-1-5-2-1\" data-name=\"footer link - privacy policy\" href=\"#\">سياسة الخصوصية</a><a data-kid=\"1-1-5-2-2\" data-name=\"footer link - terms and conditions\" href=\"#\">الشروط والأحكام</a><a data-kid=\"1-1-5-2-3\" data-name=\"footer link - contact us\" href=\"#\">اتصل بنا</a></span>\n</footer>\n</div>\n</div>",
