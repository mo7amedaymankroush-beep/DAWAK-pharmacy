      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n.dw{--green:#075e50;--green-dark:#06483f;--green-deep:#043e37;--bright:#16a783;--mint:#e1f4ed;--mint-2:#f0faf6;--orange:#f5a12a;--ink:#123d38;--muted:#708783;--border:#dcebe6;\n  font-family:'Cairo',sans-serif;background:#f5f9f7;color:var(--ink);height:940px;position:relative;overflow:hidden;padding:16px 0 0;box-sizing:border-box;}\n.dw *{box-sizing:border-box;}\n.dw .page{width:min(1356px,calc(100% - 48px));margin:0 auto;}\n\n/* خلفية الصفحة */\n.dw .topbar{height:82px;display:flex;align-items:center;gap:22px;padding:0 20px;background:#fff;border:1px solid var(--border);border-radius:18px;}\n.dw .brand{display:flex;align-items:center;gap:10px;flex:0 0 auto;text-decoration:none;}\n.dw .brand img{width:46px;height:46px;border-radius:10px;object-fit:contain;mix-blend-mode:multiply;}\n.dw .brand-name{display:flex;align-items:baseline;gap:8px;font-size:18px;font-weight:800;color:var(--green-dark);}\n.dw .brand-name strong{font-family:Inter,sans-serif;letter-spacing:-.6px;}\n.dw .nav{display:flex;align-items:center;gap:21px;margin-inline:auto;font-size:13px;font-weight:700;color:#3f615b;}\n.dw .nav a{text-decoration:none;color:inherit;position:relative;padding:7px 0;}\n.dw .nav a.active{color:var(--green);}\n.dw .nav a.active::after{content:\"\";position:absolute;bottom:0;inset-inline:0;height:3px;border-radius:3px;background:var(--bright);}\n.dw .nav-actions{display:flex;gap:8px;flex:0 0 auto;}\n.dw .cart-btn,.dw .acct-btn{height:40px;display:inline-flex;align-items:center;gap:7px;padding:0 13px;border:0;border-radius:11px;font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;}\n.dw .cart-btn{background:#e4f4ee;color:var(--green-dark);}\n.dw .cart-btn i{font-size:17px;}\n.dw .acct-btn{background:var(--green);color:#fff;}\n.dw .acct-btn i{font-size:16px;}\n.dw .band{display:flex;align-items:center;gap:12px;padding:26px 0 18px;}\n.dw .band h1{margin:0;flex:0 0 auto;font-size:26px;font-weight:800;color:var(--green-deep);}\n.dw .searchbox{flex:1 1 auto;height:48px;display:flex;align-items:center;gap:10px;padding:0 6px 0 15px;background:#fff;border:1px solid var(--border);border-radius:13px;}\n.dw .searchbox > i{font-size:18px;color:#8aa39c;}\n.dw .searchbox input{flex:1 1 auto;min-width:0;border:0;outline:0;background:transparent;font-family:inherit;font-size:13px;color:var(--ink);}\n.dw .searchbox button{height:38px;padding:0 20px;border:0;border-radius:9px;background:var(--green);color:#fff;font-family:inherit;font-size:12px;font-weight:800;}\n.dw .area-btn{height:48px;display:inline-flex;align-items:center;gap:8px;padding:0 12px;border:1px solid var(--border);border-radius:13px;background:var(--mint-2);color:var(--green-dark);font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;}\n.dw .area-btn .icon-map-pin{font-size:17px;color:var(--bright);}\n.dw .area-btn .icon-chevron-down{font-size:15px;color:#7e9a92;}\n.dw .rx-btn{height:48px;display:inline-flex;align-items:center;gap:8px;padding:0 14px;border:1px dashed #b7ddd0;border-radius:13px;background:#fff;color:var(--green);font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;}\n.dw .rx-btn i{font-size:17px;}\n.dw .cats{display:grid;grid-template-columns:repeat(5,1fr);height:76px;background:#fff;border:1px solid var(--border);border-radius:14px;overflow:hidden;}\n.dw .cat{border:0;background:transparent;display:flex;align-items:center;justify-content:center;gap:9px;font-family:inherit;font-size:13px;font-weight:800;color:#315e55;}\n.dw .cat + .cat{border-inline-start:1px solid #e8f2ee;}\n.dw .cat i{font-size:19px;color:#5f857c;}\n.dw .cat.active{background:var(--mint);color:var(--green-dark);}\n.dw .cat.active i{color:var(--green);}\n.dw .content{display:grid;grid-template-columns:minmax(0,956px) 376px;gap:24px;align-items:start;padding-top:20px;justify-content:space-between;}\n.dw .catalog{background:#fff;border:1px solid var(--border);border-radius:16px;padding:0 20px 6px;}\n.dw .catalog-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:15px 0 11px;}\n.dw .catalog-head h2{margin:0;font-size:19px;font-weight:800;color:var(--green-deep);}\n.dw .catalog-head span{font-size:12px;font-weight:700;color:#82a09a;}\n.dw .columns,.dw .row{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,.95fr) minmax(0,.72fr) 76px 150px;gap:14px;align-items:center;}\n.dw .columns{height:40px;border-bottom:1px solid var(--border);font-size:11px;font-weight:800;color:#89a49d;}\n.dw .row{height:88px;border-bottom:1px solid #eaf3ef;font-size:12px;color:var(--muted);}\n.dw .p-name{font-size:15px;font-weight:800;color:var(--green-deep);}\n.dw .p-price{font-size:14px;font-weight:800;color:var(--green-dark);white-space:nowrap;}\n.dw .add-btn{width:150px;height:38px;display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid #cfe8df;border-radius:10px;background:#f2faf6;color:var(--green);font-family:inherit;font-size:12px;font-weight:800;}\n.dw .add-btn i{font-size:15px;}\n.dw .summary{background:#fff;border:1px solid var(--border);border-radius:16px;padding:20px;}\n.dw .sum-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding-bottom:13px;border-bottom:1px solid #eaf3ef;}\n.dw .sum-head h2{margin:0;font-size:18px;font-weight:800;color:var(--green-deep);}\n.dw .sum-head span{font-size:12px;font-weight:700;color:#82a09a;}\n.dw .sum-item{display:grid;grid-template-columns:minmax(0,1fr) 40px 72px;gap:8px;align-items:center;height:64px;border-bottom:1px solid #f0f7f4;font-size:12px;}\n.dw .sum-item strong{font-size:13px;font-weight:700;color:var(--ink);}\n.dw .sum-item .q{color:#8aa39c;text-align:center;}\n.dw .sum-item .t{text-align:left;font-weight:800;color:var(--green-dark);}\n.dw .sum-totals{display:grid;gap:9px;padding-top:14px;}\n.dw .t-row{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px;color:#6f8a84;}\n.dw .t-row strong{font-weight:800;color:var(--green-dark);}\n.dw .t-row.total{margin-top:3px;padding-top:11px;border-top:1px solid var(--border);font-size:16px;font-weight:800;color:var(--green-deep);}\n.dw .checkout-btn{margin-top:16px;width:100%;height:48px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;background:var(--green);color:#fff;font-family:inherit;font-size:14px;font-weight:800;}\n.dw .checkout-btn i{font-size:17px;}\n\n/* التعتيم واللوحة */\n.dw .page.dim{opacity:.62;}\n.dw .scrim{position:absolute;inset:0;background:rgba(4,62,55,.16);z-index:20;}\n.dw .panel{position:absolute;top:0;right:0;width:760px;height:940px;background:#fff;z-index:30;box-shadow:-26px 0 70px rgba(4,62,55,.2);display:flex;flex-direction:column;}\n.dw .p-head{height:64px;flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0 24px;border-bottom:1px solid var(--border);}\n.dw .p-head h2{margin:0;font-size:18px;font-weight:800;color:var(--green-deep);}\n.dw .p-close{width:40px;height:40px;display:grid;place-items:center;border:0;border-radius:11px;background:#f0f6f3;color:#4c726a;cursor:pointer;}\n.dw .p-close i{font-size:18px;}\n.dw .p-product{display:flex;align-items:flex-start;gap:16px;padding:20px 24px;border-bottom:1px solid var(--border);}\n.dw .p-icon{width:56px;height:56px;flex:0 0 56px;display:grid;place-items:center;border-radius:14px;background:var(--mint);color:var(--green);}\n.dw .p-icon i{font-size:26px;}\n.dw .p-id{flex:1 1 auto;min-width:0;}\n.dw .p-id h3{margin:0 0 5px;font-size:20px;font-weight:800;color:var(--green-deep);}\n.dw .p-id .meta{margin:0 0 9px;font-size:12px;line-height:1.7;color:var(--muted);}\n.dw .p-prices{display:flex;align-items:baseline;gap:9px;}\n.dw .p-price-big{font-size:18px;font-weight:800;color:var(--green-dark);}\n.dw .p-base{font-size:11px;font-weight:700;color:#8aa39c;}\n.dw .p-add{align-self:center;height:44px;flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;padding:0 16px;border:1px solid #cfe8df;border-radius:11px;background:#f2faf6;color:var(--green);font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer;}\n.dw .p-add i{font-size:16px;}\n.dw .tabs{height:44px;flex:0 0 auto;display:flex;align-items:center;gap:26px;padding:0 24px;border-bottom:1px solid var(--border);}\n.dw .tab{position:relative;height:44px;border:0;background:transparent;font-family:inherit;font-size:13px;font-weight:800;color:#7f9a93;cursor:pointer;}\n.dw .tab.active{color:var(--green);}\n.dw .tab.active::after{content:\"\";position:absolute;bottom:0;inset-inline:0;height:3px;border-radius:3px;background:var(--bright);}\n.dw .p-toolbar{display:flex;align-items:center;gap:10px;padding:12px 24px;border-bottom:1px solid var(--border);flex:0 0 auto;}\n.dw .p-area{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:800;color:var(--green-dark);white-space:nowrap;}\n.dw .p-area i{font-size:16px;color:var(--bright);}\n.dw .p-change{border:0;background:transparent;padding:0;flex:0 0 auto;color:#087d68;font-family:inherit;font-size:11px;font-weight:800;text-decoration:underline;text-underline-offset:3px;white-space:nowrap;cursor:pointer;}\n.dw .p-count{margin-inline-start:auto;flex:0 0 auto;font-size:11px;font-weight:700;color:#8aa39c;white-space:nowrap;}\n.dw .sort{display:inline-flex;flex:0 0 auto;gap:3px;padding:3px;border:1px solid var(--border);border-radius:10px;background:#fff;}\n.dw .sort button{height:32px;padding:0 11px;border:0;border-radius:8px;background:transparent;color:#6f8a84;font-family:inherit;font-size:11px;font-weight:800;white-space:nowrap;cursor:pointer;}\n.dw .sort button.active{background:var(--mint);color:var(--green-dark);}\n.dw .offers{flex:1 1 auto;display:grid;align-content:start;gap:12px;padding:16px 24px;overflow:hidden;}\n.dw .offer{display:grid;grid-template-columns:minmax(0,1fr) 178px 116px;gap:16px;align-items:center;height:144px;padding:0 16px;border:1px solid var(--border);border-radius:14px;background:#fff;}\n.dw .offer.out{background:#fbfdfc;}\n.dw .o-name{display:grid;gap:6px;min-width:0;}\n.dw .o-name strong{font-size:15px;font-weight:800;color:var(--green-deep);line-height:1.4;}\n.dw .o-addr{display:flex;align-items:flex-start;gap:5px;font-size:11px;line-height:1.6;color:var(--muted);}\n.dw .o-addr i{font-size:13px;margin-top:2px;color:#8aa39c;flex:0 0 auto;}\n.dw .o-stock{display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:800;color:#16835f;}\n.dw .o-stock i{font-size:13px;}\n.dw .o-stock.out{color:#a76b21;}\n.dw .o-price{display:grid;gap:7px;}\n.dw .o-price strong{font-size:18px;font-weight:800;color:var(--green-dark);white-space:nowrap;}\n.dw .o-price strong.out{color:#7f9a93;}\n.dw .o-delivery{display:flex;align-items:center;gap:9px;font-size:11px;color:#6f8a84;white-space:nowrap;}\n.dw .o-delivery span{display:inline-flex;align-items:center;gap:4px;}\n.dw .o-delivery i{font-size:13px;color:#8aa39c;}\n.dw .o-action{width:116px;height:44px;border:0;border-radius:11px;background:var(--green);color:#fff;font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;}\n.dw .o-action:disabled{background:#eef4f1;color:#8ba59e;cursor:not-allowed;}\n.dw .p-foot{flex:0 0 auto;padding:14px 24px 20px;border-top:1px solid var(--border);display:flex;align-items:center;gap:10px;}\n.dw .more-branches{height:44px;flex:1 1 auto;display:inline-flex;align-items:center;justify-content:center;gap:7px;border:1px dashed #cfe8df;border-radius:11px;background:#f8fcfa;color:var(--green);font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;}\n.dw .more-branches i{font-size:15px;}\n.dw .p-demo{font-size:10px;font-weight:700;color:#93aba5;white-space:nowrap;}\n</style>\n<div class=\"dw\" data-kid=\"1\" data-name=\"pharmacy storefront layout container\" dir=\"rtl\">\n<div aria-hidden=\"true\" class=\"page dim\" data-kid=\"1-1\" data-name=\"dimmed background page content\">\n<header class=\"topbar\" data-kid=\"1-1-1\" data-name=\"top navigation bar\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"pharmacy brand logo link\" href=\"#\">\n<img alt=\"شعار دواك\" data-kid=\"1-1-1-1-1\" data-name=\"DAWAK logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name lockup\"><strong data-kid=\"1-1-1-1-2-1\" data-name=\"brand English name text\">DAWAK</strong><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand Arabic name text\">دواك</span></span>\n</a>\n<nav class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\" href=\"#\">الرئيسية</a>\n<a class=\"active\" data-kid=\"1-1-1-2-2\" data-name=\"active products navigation link\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"pharmacist consultation navigation link\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"FAQ navigation link\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"contact us navigation link\" href=\"#\">اتصل بنا</a>\n<a data-kid=\"1-1-1-2-6\" data-name=\"my appointments navigation link\" href=\"#\">حجوزاتي</a>\n<a data-kid=\"1-1-1-2-7\" data-name=\"my orders navigation link\" href=\"#\">طلباتي</a>\n</nav>\n<div class=\"nav-actions\" data-kid=\"1-1-1-3\" data-name=\"top bar action buttons\">\n<button class=\"cart-btn\" data-kid=\"1-1-1-3-1\" data-name=\"shopping cart button with item count\" type=\"button\"><i class=\"icon-shopping-cart\" data-kid=\"1-1-1-3-1-1\" data-name=\"shopping cart icon\"></i><span data-kid=\"1-1-1-3-1-2\" data-name=\"cart item count label\">عربة التسوق (5)</span></button>\n<button class=\"acct-btn\" data-kid=\"1-1-1-3-2\" data-name=\"user account button