      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n.dw{--green:#075e50;--green-dark:#06483f;--green-deep:#043e37;--bright:#16a783;--mint:#e1f4ed;--mint-2:#f0faf6;--orange:#f5a12a;--ink:#123d38;--muted:#708783;--border:#dcebe6;\n  font-family:'Cairo',sans-serif;background:#f5f9f7;color:var(--ink);min-height:100vh;padding:16px 0 0;box-sizing:border-box;}\n.dw *{box-sizing:border-box;}\n.dw .page{width:min(1356px,calc(100% - 48px));margin:0 auto;}\n\n/* شريط التنقل */\n.dw .topbar{height:82px;display:flex;align-items:center;gap:22px;padding:0 20px;background:#fff;border:1px solid var(--border);border-radius:18px;}\n.dw .brand{display:flex;align-items:center;gap:10px;flex:0 0 auto;text-decoration:none;}\n.dw .brand img{width:46px;height:46px;border-radius:10px;object-fit:contain;mix-blend-mode:multiply;}\n.dw .brand-name{display:flex;align-items:baseline;gap:8px;font-size:18px;font-weight:800;color:var(--green-dark);}\n.dw .brand-name strong{font-family:Inter,sans-serif;letter-spacing:-.6px;}\n.dw .nav{display:flex;align-items:center;gap:21px;margin-inline:auto;font-size:13px;font-weight:700;color:#3f615b;}\n.dw .nav a{text-decoration:none;color:inherit;position:relative;padding:7px 0;}\n.dw .nav a.active{color:var(--green);}\n.dw .nav a.active::after{content:\"\";position:absolute;bottom:0;inset-inline:0;height:3px;border-radius:3px;background:var(--bright);}\n.dw .nav-actions{display:flex;gap:8px;flex:0 0 auto;}\n.dw .cart-btn,.dw .acct-btn{height:40px;display:inline-flex;align-items:center;gap:7px;padding:0 13px;border:0;border-radius:11px;font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;}\n.dw .cart-btn{background:var(--mint);color:var(--green-dark);}\n.dw .cart-btn i{font-size:17px;}\n.dw .acct-btn{background:var(--green);color:#fff;}\n.dw .acct-btn i{font-size:16px;}\n\n/* رأس الصفحة */\n.dw .head{display:flex;align-items:center;gap:16px;padding:26px 0 18px;}\n.dw .back{height:40px;display:inline-flex;align-items:center;gap:7px;padding:0 12px;border:1px solid var(--border);border-radius:11px;background:#fff;color:var(--green-dark);font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer;}\n.dw .back i{font-size:16px;}\n.dw .head h1{margin:0;font-size:28px;font-weight:800;color:var(--green-deep);}\n.dw .head .meta{font-size:12px;font-weight:700;color:#82a09a;}\n\n/* التخطيط */\n.dw .layout{width:min(1180px,100%);margin:0 auto;display:grid;grid-template-columns:minmax(0,732px) 420px;gap:28px;align-items:start;justify-content:space-between;}\n\n/* العناصر */\n.dw .items{background:#fff;border:1px solid var(--border);border-radius:16px;padding:0 20px 6px;}\n.dw .cols3,.dw .item{display:grid;grid-template-columns:minmax(0,1fr) 128px 104px 104px 40px;gap:14px;align-items:center;}\n.dw .cols3{height:38px;border-bottom:1px solid var(--border);font-size:11px;font-weight:800;color:#89a49d;}\n.dw .item{height:88px;border-bottom:1px solid #eaf3ef;}\n.dw .item:last-child{border-bottom:0;}\n.dw .i-id{display:grid;gap:4px;min-width:0;}\n.dw .i-id strong{font-size:15px;font-weight:800;color:var(--green-deep);}\n.dw .i-id small{font-size:11px;color:var(--muted);line-height:1.6;}\n.dw .qty{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:10px;height:40px;width:fit-content;}\n.dw .qty button{width:34px;height:38px;display:grid;place-items:center;border:0;background:transparent;color:var(--green);font-family:inherit;font-size:14px;cursor:pointer;}\n.dw .qty span{width:34px;text-align:center;font-size:12px;font-weight:800;color:var(--green-dark);}\n.dw .unit{font-size:12px;color:#6f8a84;}\n.dw .line-total{font-size:14px;font-weight:800;color:var(--green-dark);}\n.dw .del{width:36px;height:36px;display:grid;place-items:center;border:0;border-radius:9px;background:#fff0ed;color:#b24636;cursor:pointer;}\n.dw .del i{font-size:15px;}\n\n/* بيانات التوصيل */\n.dw .delivery{margin-top:20px;background:#fff;border:1px solid var(--border);border-radius:16px;padding:20px;}\n.dw .delivery h2{margin:0 0 16px;font-size:18px;font-weight:800;color:var(--green-deep);}\n.dw .form{display:grid;grid-template-columns:1fr 1fr;gap:14px;}\n.dw .field{display:grid;gap:6px;}\n.dw .field.full{grid-column:1 / -1;}\n.dw .field label{font-size:12px;font-weight:700;color:#4c726a;}\n.dw .field input{height:46px;padding:0 12px;border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--ink);font-family:inherit;font-size:13px;outline:0;}\n.dw .field input:focus{border-color:var(--bright);box-shadow:0 0 0 3px rgba(22,167,131,.12);}\n.dw .pharm{margin-top:14px;padding-top:14px;border-top:1px solid #eaf3ef;}\n.dw .pharm h3{margin:0 0 10px;font-size:13px;font-weight:800;color:var(--green-dark);}\n.dw .opt{display:flex;align-items:center;gap:12px;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:#fff;margin-bottom:9px;cursor:pointer;}\n.dw .opt.selected{border-color:var(--bright);background:var(--mint-2);}\n.dw .radio{width:18px;height:18px;flex:0 0 18px;border-radius:50%;border:2px solid #c3dcd4;background:#fff;}\n.dw .opt.selected .radio{border-color:var(--bright);background:var(--bright);box-shadow:inset 0 0 0 3px #fff;}\n.dw .opt-info{flex:1 1 auto;min-width:0;}\n.dw .opt-info strong{display:block;font-size:13px;font-weight:800;color:var(--green-deep);}\n.dw .opt-info small{font-size:11px;color:var(--muted);}\n.dw .opt .amount{font-size:13px;font-weight:800;color:var(--green-dark);white-space:nowrap;}\n.dw .opt.off{background:#fbfdfc;}\n.dw .opt.off strong{color:#6f8a84;}\n.dw .opt.off .amount{color:#93aba5;font-weight:700;}\n.dw .confirm{margin-top:20px;display:flex;align-items:center;gap:12px;}\n.dw .confirm-btn{height:48px;display:inline-flex;align-items:center;gap:8px;padding:0 26px;border:0;border-radius:12px;background:var(--green);color:#fff;font-family:inherit;font-size:14px;font-weight:800;cursor:pointer;}\n.dw .confirm-btn i{font-size:17px;}\n.dw .confirm-btn:hover{background:var(--green-dark);}\n\n/* الملخص */\n.dw .summary{position:sticky;top:16px;background:#fff;border:1px solid var(--border);border-radius:16px;padding:20px;}\n.dw .summary h2{margin:0 0 14px;padding-bottom:13px;border-bottom:1px solid #eaf3ef;font-size:18px;font-weight:800;color:var(--green-deep);}\n.dw .t-row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:7px 0;font-size:13px;color:#6f8a84;}\n.dw .t-row strong{font-weight:800;color:var(--green-dark);}\n.dw .t-row.total{margin-top:6px;padding-top:14px;border-top:1px solid var(--border);font-size:16px;font-weight:800;color:var(--green-deep);}\n.dw .t-row.total strong{font-size:19px;}\n.dw .summary-btn{margin-top:16px;width:100%;height:48px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid #cfe8df;border-radius:12px;background:var(--mint-2);color:var(--green);font-family:inherit;font-size:14px;font-weight:800;cursor:pointer;}\n.dw .summary-btn:hover{background:var(--mint);}\n.dw .summary-btn i{font-size:17px;}\n\n.dw .footer{margin-top:26px;border-top:1px solid var(--border);padding:16px 0 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:11px;font-weight:700;color:#7f9a93;}\n.dw .footer .links{display:flex;gap:18px;}\n.dw .footer-brand{display:flex;align-items:center;gap:8px;color:var(--green-dark);font-weight:800;}\n.dw .footer-brand img{width:28px;height:28px;border-radius:7px;object-fit:contain;mix-blend-mode:multiply;}\n</style>\n<div class=\"dw\" data-kid=\"1\" data-name=\"shopping cart page root\" dir=\"rtl\">\n<div class=\"page\" data-kid=\"1-1\" data-name=\"page layout container\">\n<header class=\"topbar\" data-kid=\"1-1-1\" data-name=\"main navigation bar\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"شعار دواك\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\"><strong data-kid=\"1-1-1-1-2-1\" data-name=\"brand English name\">DAWAK</strong><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand Arabic name\">دواك</span></span>\n</a>\n<nav class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"primary site navigation\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link home\" href=\"#\">الرئيسية</a>\n<a class=\"active\" data-kid=\"1-1-1-2-2\" data-name=\"nav link active products\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link pharmacist consultation\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link FAQ\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link contact us\" href=\"#\">اتصل بنا</a>\n<a data-kid=\"1-1-1-2-6\" data-name=\"nav link bookings\" href=\"#\">حجوزاتي</a>\n<a data-kid=\"1-1-1-2-7\" data-name=\"nav link orders\" href=\"#\">طلباتي</a>\n</nav>\n<div class=\"nav-actions\" data-kid=\"1-1-1-3\" data-name=\"nav action buttons container\">\n<button class=\"cart-btn\" data-kid=\"1-1-1-3-1\" data-name=\"shopping cart button with count\" type=\"button\"><i class=\"icon-shopping-cart\" data-kid=\"1-1-1-3-1-1\" data-name=\"shopping cart icon\"></i><span data-kid=\"1-1-1-3-1-2\" data-name=\"cart label with item count\">عربة التسوق (5)</span></button>\n<button class=\"acct-btn\" data-kid=\"1-1-1-3-2\" data-name=\"account button\" type=\"button\"><i class=\"icon-user\" data-kid=\"1-1-1-3-2-1\" data-name=\"user icon\"></i><span data-kid=\"1-1-1-3-2-2\" data-name=\"account label text\">حسابك</span></button>\n</div>\n</header>\n<div class=\"head\" data-kid=\"1-1-2\" data-name=\"page header section\">\n<button class=\"back\" data-kid=\"1-1-2-1\" data-name=\"back to products button\" type=\"button\"><i class=\"icon-arrow-right\" data-kid=\"1-1-2-1-1\"></i>رجوع للمنتجات</button>\n<h1 data-kid=\"1-1-2-2\" data-name=\"page title cart heading\">العربة</h1>\n<span class=\"meta\" data-kid=\"1-1-2-3\" data-name=\"cart summary meta text\">4 منتجات · 5 وحدات</span>\n</div>\n<div class=\"layout\" data-kid=\"1-1-3\" data-name=\"main two-column layout\">\n<div class=\"main\" data-kid=\"1-1-3-1\" data-name=\"main content column\">\n<section aria-label=\"منتجات العربة\" class=\"items\" data-kid=\"1-1-3-1-1\" data-name=\"cart items section\">\n<div class=\"cols3\" data-kid=\"1-1-3-1-1-1\" data-name=\"cart items table header row\">\n<span data-kid=\"1-1-3-1-1-1-1\" data-name=\"column header product\">المنتج</span><span data-kid=\"1-1-3-1-1-1-2\" data-name=\"column header quantity\">الكمية</span><span data-kid=\"1-1-3-1-1-1-3\" data-name=\"column header unit price\">سعر القطعة</span><span data-kid=\"1-1-3-1-1-1-4\" data-name=\"column header total\">الإجمالي</span><span data-kid=\"1-1-3-1-1-1-5\" data-name=\"column header empty spare\"></span>\n</div>\n<article class=\"item\" data-kid=\"1-1-3-1-1-2\" data-name=\"cart item row Panadol\">\n<div class=\"i-id\" data-kid=\"1-1-3-1-1-2-1\" data-name=\"item identity container\"><strong data-kid=\"1-1-3-1-1-2-1-1\" data-name=\"item product name\">بانادول</strong><small data-kid=\"1-1-3-1-1-2-1-2\" data-name=\"item product description\">باراسيتامول 500 مج · أقراص · عبوة 20 قرص</small></div>\n<div class=\"qty\" data-kid=\"1-1-3-1-1-2-2\" data-name=\"quantity stepper control\">\n<button aria-label=\"تقليل الكمية\" data-kid=\"1-1-3-1-1-2-2-1\" data-name=\"decrease quantity button\" type=\"button\"><i class=\"icon-minus\" data-kid=\"1-1-3-1-1-2-2-1-1\" data-name=\"minus icon\"></i></button>\n<span data-kid=\"1-1-3-1-1-2-2-2\" data-name=\"quantity value display\">1</span>\n<button aria-label=\"زيادة الكمية\" data-kid=\"1-1-3-1-1-2-2-3\" data-name=\"increase quantity button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-3-1-1-2-2-3-1\" data-name=\"plus icon\"></i></button>\n</div>\n<span class=\"unit\" data-kid=\"1-1-3-1-1-2-3\" data-name=\"item unit price text\">37 ج.م</span>\n<span class=\"line-total\" data-kid=\"1-1-3-1-1-2-4\" data-name=\"item line total price\">37 ج.م</span>\n<button aria-label=\"حذف بانادول\" class=\"del\" data-kid=\"1-1-3-1-1-2-5\" data-name=\"remove item button\" type=\"button\"><i class=\"icon-trash-2\" data-kid=\"1-1-3-1-1-2-5-1\" data-name=\"trash icon\"></i></button>\n</article>\n<article class=\"item\" data-kid=\"1-1-3-1-1-3\" data-name=\"cart item row Brufen\">\n<div class=\"i-id\" data-kid=\"1-1-3-1-1-3-1\" data-name=\"item identity container\"><strong data-kid=\"1-1-3-1-1-3-1-1\" data-name=\"item product name\">بروفين</strong><small data-kid=\"1-1-3-1-1-3-1-2\" data-name=\"item product description\">إيبوبروفين 400 مج · أقراص · عبوة أقراص</small></div>\n<div class=\"qty\" data-kid=\"1-1-3-1-1-3-2\" data-name=\"quantity stepper control\">\n<button aria-label=\"تقليل الكمية\" data-kid=\"1-1-3-1-1-3-2-1\" data-name=\"decrease quantity button\" type=\"button\"><i class=\"icon-minus\" data-kid=\"1-1-3-1-1-3-2-1-1\" data-name=\"minus icon\"></i></button>\n<span data-kid=\"1-1-3-1-1-3-2-2\" data-name=\"quantity value display\">2</span>\n<button aria-label=\"زيادة الكمية\" data-kid=\"1-1-3-1-1-3-2-3\" data-name=\"increase quantity button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-3-1-1-3-2-3-1\" data-name=\"plus icon\"></i></button>\n</div>\n<span class=\"unit\" data-kid=\"1-1-3-1-1-3-3\" data-name=\"item unit price text\">46 ج.م</span>\n<span class=\"line-total\" data-kid=\"1-1-3-1-1-3-4\" data-name=\"item line total price\">92 ج.م</span>\n<button aria-label=\"حذف بروفين\" class=\"del\" data-kid=\"1-1-3-1-1-3-5\" data-name=\"remove item button\" type=\"button\"><i class=\"icon-trash-2\" data-kid=\"1-1-3-1-1-3-5-1\" data-name=\"trash icon\"></i></button>\n</article>\n<article class=\"item\" data-kid=\"1-1-3-1-1-4\" data-name=\"cart item row Bepanthen\">\n<div class=\"i-id\" data-kid=\"1-1-3-1-1-4-1\" data-name=\"item identity container\"><strong data-kid=\"1-1-3-1-1-4-1-1\" data-name=\"item product name\">بيبانثين</strong><small data-kid=\"1-1-3-1-1-4-1-2\" data-name=\"item product description\">ديكسبانثينول 5% · كريم · عبوة 30 جم</small></div>\n<div class=\"qty\" data-kid=\"1-1-3-1-1-4-2\" data-name=\"quantity stepper control\">\n<button aria-label=\"تقليل الكمية\" data-kid=\"1-1-3-1-1-4-2-1\" data-name=\"decrease quantity button\" type=\"button\"><i class=\"icon-minus\" data-kid=\"1-1-3-1-1-4-2-1-1\" data-name=\"minus icon\"></i></button>\n<span data-kid=\"1-1-3-1-1-4-2-2\" data-name=\"quantity value display\">1</span>\n<button aria-label=\"زيادة الكمية\" data-kid=\"1-1-3-1-1-4-2-3\" data-name=\"increase quantity button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-3-1-1-4-2-3-1\" data-name=\"plus icon\"></i></button>\n</div>\n<span class=\"unit\" data-kid=\"1-1-3-1-1-4-3\" data-name=\"item unit price text\">92 ج.م</span>\n<span class=\"line-total\" data-kid=\"1-1-3-1-1-4-4\" data-name=\"item line total price\">92 ج.م</span>\n<button aria-label=\"حذف بيبانثين\" class=\"del\" data-kid=\"1-1-3-1-1-4-5\" data-name=\"remove item button\" type=\"button\"><i class=\"icon-trash-2\" data-kid=\"1-1-3-1-1-4-5-1\" data-name=\"trash icon\"></i></button>\n</article>\n<article class=\"item\" data-kid=\"1-1-3-1-1-5\" data-name=\"cart item row Vitamin C\">\n<div class=\"i-id\" data-kid=\"1-1-3-1-1-5-1\" data-name=\"item identity container\"><strong data-kid=\"1-1-3-1-1-5-1-1\" data-name=\"item product name\">فيتامين سي</strong><small data-kid=\"1-1-3-1-1-5-1-2\" data-name=\"item product description\">فيتامين C 1000 مج · أقراص · عبوة أقراص</small></div>\n<div class=\"qty\" data-kid=\"1-1-3-1-1-5-2\" data-name=\"quantity stepper control\">\n<button aria-label=\"تقليل الكمية\" data-kid=\"1-1-3-1-1-5-2-1\" data-name=\"decrease quantity button\" type=\"button\"><i class=\"icon-minus\" data-kid=\"1-1-3-1-1-5-2-1-1\" data-name=\"minus icon\"></i></button>\n<span data-kid=\"1-1-3-1-1-5-2-2\" data-name=\"quantity value display\">1</span>\n<button aria-label=\"زيادة الكمية\" data-kid=\"1-1-3-1-1-5-2-3\" data-name=\"increase quantity button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-3-1-1-5-2-3-1\" data-name=\"plus icon\"></i></button>\n</div>\n<span class=\"unit\" data-kid=\"1-1-3-1-1-5-3\" data-name=\"item unit price text\">124 ج.م</span>\n<span class=\"line-total\" data-kid=\"1-1-3-1-1-5-4\" data-name=\"item line total price\">124 ج.م</span>\n<button aria-label=\"حذف فيتامين سي\" class=\"del\" data-kid=\"1-1-3-1-1-5-5\" data-name=\"remove item button\" type=\"button\"><i class=\"icon-trash-2\" data-kid=\"1-1-3-1-1-5-5-1\" data-name=\"trash icon\"></i></button>\n</article>\n</section>\n<section aria-label=\"بيانات التوصيل\" class=\"delivery\" data-kid=\"1-1-3-1-2\" data-name=\"delivery details section\" id=\"delivery\">\n<h2 data-kid=\"1-1-3-1-2-1\" data-name=\"delivery section heading\">بيانات التوصيل</h2>\n<form class=\"form\" data-kid=\"1-1-3-1-2-2\" data-name=\"delivery information form\">\n<div class=\"field\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"customer name field\">\n<label data-kid=\"1-1-3-1-2-2-1-1\" data-name=\"full name label\" for=\"cust-name\">الاسم بالكامل</label>\n<input data-kid=\"1-1-3-1-2-2-1-2\" data-name=\"full name text input\" id=\"cust-name\" type=\"text\" value=\"منى عبد الرحمن\"/>\n</div>\n<div class=\"field\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"customer phone field\">\n<label data-kid=\"1-1-3-1-2-2-2-1\" data-name=\"mobile number label\" for=\"cust-phone\">رقم الموبايل</label>\n<input data-kid=\"1-1-3-1-2-2-2-2\" data-name=\"mobile number input field\" dir=\"ltr\" id=\"cust-phone\" type=\"tel\" value=\"01023456789\"/>\n</div>\n<div class=\"field full\" data-kid=\"1-1-3-1-2-2-3\" data-name=\"customer address field\">\n<label data-kid=\"1-1-3-1-2-2-3-1\" data-name=\"address label\" for=\"cust-address\">العنوان</label>\n<input data-kid=\"1-1-3-1-2-2-3-2\" data-name=\"address tex