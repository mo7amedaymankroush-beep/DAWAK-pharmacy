      "html": "<div class=\"dawak\" data-kid=\"1\" data-name=\"pharmacy cart page root container\" dir=\"rtl\" lang=\"ar\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n.dawak{--ink:#122E29;--ink2:#3F5B54;--muted:#6C837C;--line:#E1EAE6;--line2:#D2E0DA;--line3:#EDF3EF;--brand:#0C5449;--brand-deep:#093B34;--accent:#12836B;--mint:#EAF4F0;--mint2:#F3F9F6;font-family:'Cairo',system-ui,-apple-system,sans-serif;background:linear-gradient(180deg,#EDF6F1 0,#F4F7F5 280px);color:var(--ink);min-height:100vh;padding-bottom:10px;-webkit-font-smoothing:antialiased}\n.dawak *{box-sizing:border-box}\n:where(.dawak) button,:where(.dawak) input,:where(.dawak) textarea{font:inherit;color:inherit}\n:where(.dawak) button{border:0;background:none;cursor:pointer}\n.dawak a{color:inherit;text-decoration:none}\n.ico{display:inline-block;font-style:normal;font-weight:400;line-height:1;font-size:16px}\n.page{max-width:1356px;margin:0 auto;padding:16px 42px 0}\n\n.topbar{height:82px;display:flex;align-items:center;gap:24px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:0 20px;box-shadow:0 6px 20px rgba(9,59,52,.05)}\n.brand{display:flex;align-items:center;gap:10px;flex:none}\n.brand img{width:44px;height:44px;border-radius:10px;object-fit:contain;mix-blend-mode:multiply}\n.brand-txt{display:grid;gap:1px;line-height:1.15}\n.brand-txt b{font-size:18px;font-weight:800;color:var(--brand-deep)}\n.brand-txt span{font-size:8.5px;font-weight:700;letter-spacing:1.5px;color:var(--muted)}\n.nav{flex:1;display:flex;align-items:center;justify-content:center;gap:20px}\n.nav a{font-size:12.5px;font-weight:700;color:#4D655F;padding:10px 2px;white-space:nowrap}\n.acts{display:flex;gap:8px;flex:none}\n.btn-cart{height:40px;padding:0 14px;border:1px solid #CBE1D8;border-radius:10px;background:var(--mint);color:var(--brand-deep);display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800}\n.btn-account{height:40px;padding:0 14px;border-radius:10px;background:var(--brand);color:#fff;display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800}\n\n.body{width:1180px;max-width:1180px;margin:0 auto}\n.ph{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:22px 0 16px}\n.ph-r{display:grid;gap:8px}\n.ph h1{font-size:26px;font-weight:800;color:var(--brand-deep);margin:0;letter-spacing:-.3px}\n.src{display:inline-flex;align-items:center;gap:8px;height:34px;padding:0 12px;border:1px solid #CFE6DD;border-radius:999px;background:#fff;color:var(--brand-deep);font-size:11.5px;font-weight:800}\n.src .ico{font-size:15px;color:var(--accent)}\n.src .link{border:0;background:none;color:var(--accent);font-size:11px;font-weight:800;padding:0;border-inline-start:1px solid var(--line);padding-inline-start:9px}\n.back2{display:inline-flex;align-items:center;gap:7px;height:38px;padding:0 13px;border:1px solid var(--line2);border-radius:9px;background:#fff;color:var(--brand);font-size:11.5px;font-weight:800}\n.back2 .ico{font-size:15px}\n\n.checkout{display:grid;grid-template-columns:724px 428px;gap:28px;align-items:start}\n\n.items{background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 10px 26px rgba(9,59,52,.04)}\n.items-head{display:grid;grid-template-columns:minmax(0,1fr) 84px 108px 84px 24px;gap:12px;align-items:center;height:38px;padding:0 18px;background:var(--mint2);border-bottom:1px solid var(--line);border-radius:14px 14px 0 0;font-size:10.5px;font-weight:800;color:#5F7A72}\n.item{display:grid;grid-template-columns:minmax(0,1fr) 84px 108px 84px 24px;gap:12px;align-items:center;height:88px;padding:0 18px;border-bottom:1px solid var(--line3)}\n.item:last-child{border-bottom:0}\n.prod{display:flex;align-items:center;gap:10px;min-width:0}\n.prod .th{width:42px;height:42px;border-radius:10px;background:var(--mint2);color:var(--brand);display:grid;place-items:center;font-size:19px;flex:none}\n.prod h3{font-size:13.5px;font-weight:800;color:var(--brand-deep);margin:0 0 2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.prod p{font-size:10.5px;font-weight:700;color:var(--muted);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.unit{font-size:12.5px;font-weight:700;color:#4E6A63;font-variant-numeric:tabular-nums}\n.qty{display:flex;align-items:center;justify-content:space-between;height:36px;border:1px solid var(--line2);border-radius:9px;padding:0 4px;background:#fff}\n.qty button{width:28px;height:28px;border-radius:6px;background:var(--mint2);color:var(--brand);display:grid;place-items:center}\n.qty button .ico{font-size:13px}\n.qty span{font-size:12.5px;font-weight:800;min-width:18px;text-align:center;font-variant-numeric:tabular-nums}\n.line{font-size:13.5px;font-weight:800;color:var(--brand-deep);font-variant-numeric:tabular-nums}\n.del{width:28px;height:28px;border-radius:7px;background:#FDF3F1;color:#B04A38;display:grid;place-items:center}\n.del .ico{font-size:14px}\n\n.panel{background:#fff;border:1px solid var(--line);border-radius:14px;padding:20px;display:grid;gap:13px;box-shadow:0 12px 28px rgba(9,59,52,.05)}\n.panel h2{font-size:15px;font-weight:800;color:var(--brand-deep);margin:0}\n.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}\n.f{display:grid;gap:6px;min-width:0}\n.f label{font-size:10.5px;font-weight:800;color:#4E6A63}\n.f input,.f textarea{width:100%;height:42px;border:1px solid var(--line2);border-radius:9px;padding:0 11px;font-size:12.5px;font-weight:700;color:var(--ink);background:#fff;outline:none}\n.f textarea{height:62px;padding:9px 11px;resize:none;line-height:1.6}\n.f input::placeholder,.f textarea::placeholder{color:#96A8A2;font-weight:600}\n.method{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:4px;border:1px solid var(--line2);border-radius:10px}\n.method button{height:36px;border-radius:7px;background:transparent;color:#5A736C;font-size:11.5px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:6px}\n.method button .ico{font-size:15px}\n.method button.on{background:var(--mint);color:var(--brand-deep)}\n.totals{display:grid;gap:8px;padding-top:12px;border-top:1px solid var(--line)}\n.totals div{display:flex;align-items:baseline;justify-content:space-between;font-size:12px;font-weight:700;color:#4E6A63}\n.totals b{font-size:12.5px;font-weight:800;color:var(--ink);font-variant-numeric:tabular-nums}\n.totals .grand{padding-top:10px;border-top:1px solid var(--line)}\n.totals .grand span{font-size:13px;font-weight:800;color:var(--brand-deep)}\n.totals .grand b{font-size:19px;font-weight:800;color:var(--brand-deep)}\n.confirm{height:48px;border-radius:11px;background:var(--brand);color:#fff;font-size:13.5px;font-weight:800;display:flex;align-items:center;justify-content:center;gap:8px}\n.confirm .ico{font-size:16px}\n.note{margin:0;text-align:center;font-size:10.5px;font-weight:700;color:var(--muted);line-height:1.7}\n\n.foot{margin-top:26px;border-top:1px solid var(--line);padding:16px 0 20px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:11.5px;font-weight:700;color:var(--muted)}\n.links{display:flex;gap:18px}\n.links a{color:#4E6A63}\n</style>\n<div class=\"page\" data-kid=\"1-1\" data-name=\"page layout container\">\n<header class=\"topbar\" data-kid=\"1-1-1\" data-name=\"top navigation bar\">\n<div class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo group\">\n<img alt=\"شعار دواك\" data-kid=\"1-1-1-1-1\" data-name=\"pharmacy logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-txt\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text block\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"brand Arabic name\">دواك</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand English subtitle\">DAWAK PHARMACY</span></span>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-1-2\