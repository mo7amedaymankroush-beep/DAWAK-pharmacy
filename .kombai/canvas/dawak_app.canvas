      "html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n\n.dw{--green:#075e50;--green-dark:#06483f;--green-deep:#043e37;--bright:#16a783;--mint:#e1f4ed;--mint-2:#f0faf6;--orange:#f5a12a;--ink:#123d38;--muted:#708783;--border:#dcebe6;\n  font-family:'Cairo',sans-serif;background:#f5f9f7;color:var(--ink);min-height:100vh;padding:16px 0 0;box-sizing:border-box;}\n.dw *{box-sizing:border-box;}\n.dw .page{width:min(1356px,calc(100% - 48px));margin:0 auto;}\n\n/* شريط التنقل */\n.dw .topbar{height:82px;display:flex;align-items:center;gap:22px;padding:0 20px;background:#fff;border:1px solid var(--border);border-radius:18px;}\n.dw .brand{display:flex;align-items:center;gap:10px;flex:0 0 auto;text-decoration:none;}\n.dw .brand img{width:46px;height:46px;border-radius:10px;object-fit:contain;mix-blend-mode:multiply;}\n.dw .brand-name{display:flex;align-items:baseline;gap:8px;font-size:18px;font-weight:800;color:var(--green-dark);}\n.dw .brand-name strong{font-family:Inter,sans-serif;letter-spacing:-.6px;}\n.dw .nav{display:flex;align-items:center;gap:21px;margin-inline:auto;font-size:13px;font-weight:700;color:#3f615b;}\n.dw .nav a{text-decoration:none;color:inherit;position:relative;padding:7px 0;}\n.dw .nav a.active{color:var(--green);}\n.dw .nav a.active::after{content:\"\";position:absolute;bottom:0;inset-inline:0;height:3px;border-radius:3px;background:var(--bright);}\n.dw .nav-actions{display:flex;gap:8px;flex:0 0 auto;}\n.dw .cart-btn,.dw .acct-btn{height:40px;display:inline-flex;align-items:center;gap:7px;padding:0 13px;border:0;border-radius:11px;font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;white-space:nowrap;}\n.dw .cart-btn{background:#e4f4ee;color:var(--green-dark);}\n.dw .cart-btn i{font-size:17px;}\n.dw .acct-btn{background:var(--green);color:#fff;}\n.dw .acct-btn i{font-size:16px;}\n\n/* البحث والمنطقة والروشتة */\n.dw .band{display:flex;align-items:center;gap:12px;padding:26px 0 18px;}\n.dw .band h1{margin:0;flex:0 0 auto;font-size:26px;font-weight:800;color:var(--green-deep);}\n.dw .searchbox{flex:1 1 auto;height:48px;display:flex;align-items:center;gap:10px;padding:0 6px 0 15px;background:#fff;border:1px solid var(--border);border-radius:13px;}\n.dw .searchbox > i{font-size:18px;color:#8aa39c;}\n.dw .searchbox input{flex:1 1 auto;min-width:0;border:0;outline:0;background:transparent;font-family:inherit;font-size:13px;color:var(--ink);}\n.dw .searchbox input::placeholder{color:#9aaca7;}\n.dw .searchbox button{height:38px;padding:0 20px;border:0;border-radius:9px;background:var(--green);color:#fff;font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;}\n.dw .area-btn{height:48px;display:inline-flex;align-items:center;gap:8px;padding:0 12px;border:1px solid var(--border);border-radius:13px;background:var(--mint-2);color:var(--green-dark);font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer;}\n.dw .area-btn .icon-map-pin{font-size:17px;color:var(--bright);}\n.dw .area-btn .icon-chevron-down{font-size:15px;color:#7e9a92;}\n.dw .rx-btn{height:48px;display:inline-flex;align-items:center;gap:8px;padding:0 14px;border:1px dashed #b7ddd0;border-radius:13px;background:#fff;color:var(--green);font-family:inherit;font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer;}\n.dw .rx-btn i{font-size:17px;}\n\n/* الأقسام */\n.dw .cats{display:grid;grid-template-columns:repeat(5,1fr);height:76px;background:#fff;border:1px solid var(--border);border-radius:14px;overflow:hidden;}\n.dw .cat{border:0;background:transparent;display:flex;align-items:center;justify-content:center;gap:9px;font-family:inherit;font-size:13px;font-weight:800;color:#315e55;cursor:pointer;}\n.dw .cat + .cat{border-inline-start:1px solid #e8f2ee;}\n.dw .cat i{font-size:19px;color:#5f857c;}\n.dw .cat.active{background:var(--mint);color:var(--green-dark);}\n.dw .cat.active i{color:var(--green);}\n\n/* العمودان */\n.dw .content{display:grid;grid-template-columns:minmax(0,956px) 376px;gap:24px;align-items:start;padding-top:20px;justify-content:space-between;}\n\n.dw .catalog{background:#fff;border:1px solid var(--border);border-radius:16px;padding:0 20px 6px;}\n.dw .catalog-head{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:15px 0 11px;}\n.dw .catalog-head h2{margin:0;font-size:19px;font-weight:800;color:var(--green-deep);}\n.dw .catalog-head span{font-size:12px;font-weight:700;color:#82a09a;}\n.dw .columns,.dw .row{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr) minmax(0,.95fr) minmax(0,.72fr) 76px 150px;gap:14px;align-items:center;}\n.dw .columns{height:40px;border-bottom:1px solid var(--border);font-size:11px;font-weight:800;color:#89a49d;}\n.dw .row{height:88px;border-bottom:1px solid #eaf3ef;font-size:12px;color:var(--muted);}\n.dw .p-name{font-size:15px;font-weight:800;color:var(--green-deep);}\n.dw .p-price{font-size:14px;font-weight:800;color:var(--green-dark);white-space:nowrap;}\n.dw .add-btn{width:150px;height:38px;display:inline-flex;align-items:center;justify-content:center;gap:6px;border:1px solid #cfe8df;border-radius:10px;background:#f2faf6;color:var(--green);font-family:inherit;font-size:12px;font-weight:800;cursor:pointer;}\n.dw .add-btn i{font-size:15px;}\n.dw .add-btn:hover{background:var(--green);border-color:var(--green);color:#fff;}\n.dw .more{width:100%;height:52px;display:flex;align-items:center;justify-content:center;gap:8px;border:0;background:transparent;color:var(--green);font-family:inherit;font-size:13px;font-weight:800;cursor:pointer;}\n.dw .more i{font-size:16px;}\n\n/* ملخص العربة */\n.dw .summary{background:#fff;border:1px solid var(--border);border-radius:16px;padding:20px;position:sticky;top:16px;}\n.dw .sum-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding-bottom:13px;border-bottom:1px solid #eaf3ef;}\n.dw .sum-head h2{margin:0;font-size:18px;font-weight:800;color:var(--green-deep);}\n.dw .sum-head span{font-size:12px;font-weight:700;color:#82a09a;}\n.dw .sum-item{display:grid;grid-template-columns:minmax(0,1fr) 40px 72px;gap:8px;align-items:center;height:64px;border-bottom:1px solid #f0f7f4;font-size:12px;}\n.dw .sum-item strong{font-size:13px;font-weight:700;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}\n.dw .sum-item .q{color:#8aa39c;text-align:center;}\n.dw .sum-item .t{text-align:left;font-weight:800;color:var(--green-dark);}\n.dw .sum-totals{display:grid;gap:9px;padding-top:14px;}\n.dw .t-row{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px;color:#6b857f;}\n.dw .t-row strong{font-weight:800;color:var(--green-dark);}\n.dw .t-row.grand{margin-top:3px;padding-top:11px;border-top:1px solid var(--border);font-size:16px;font-weight:800;color:var(--green-deep);}\n.dw .t-row.grand strong{font-size:18px;}\n.dw .checkout-btn{margin-top:16px;width:100%;height:48px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border:0;border-radius:12px;background:var(--green);color:#fff;font-family:inherit;font-size:14px;font-weight:800;cursor:pointer;}\n.dw .checkout-btn i{font-size:17px;}\n.dw .checkout-btn:hover{background:var(--green-dark);}\n\n/* تذييل */\n.dw .footer{margin-top:26px;border-top:1px solid var(--border);padding:16px 0 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;font-size:11px;font-weight:700;color:#7f9a93;}\n.dw .footer .links{display:flex;gap:18px;}\n.dw .footer a{color:inherit;text-decoration:none;}\n.dw .footer-brand{display:flex;align-items:center;gap:8px;color:var(--green-dark);font-weight:800;}\n.dw .footer-brand img{width:28px;height:28px;border-radius:7px;object-fit:contain;mix-blend-mode:multiply;}\n</style>\n<div class=\"dw\" data-kid=\"1\" data-name=\"page root container\" dir=\"rtl\">\n<div class=\"page\" data-kid=\"1-1\" data-name=\"page layout container\">\n<header class=\"topbar\" data-kid=\"1-1-1\" data-name=\"main navigation bar\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"شعار دواك\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name wrapper\"><strong data-kid=\"1-1-1-1-2-1\" data-name=\"brand name Latin text\">DAWAK</strong><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand name Arabic text\">دواك</span></span>\n</a>\n<nav class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"primary navigation menu\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link home\" href=\"#\">الرئيسية</a>\n<a class=\"active\" data-kid=\"1-1-1-2-2\" data-name=\"nav link products (active)\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link pharmacist consultation\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link FAQ\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link contact us\" href=\"#\">اتصل بنا</a>\n<a data-kid=\"1-1-1-2-6\" data-name=\"nav link my bookings\" href=\"#\">حجوزاتي</a>\n<a data-kid=\"1-1-1-2-7\" data-name=\"nav link my orders\" href=\"#\">طلباتي</a>\n</nav>\n<div class=\"nav-actions\" data-kid=\"1-1-1-3\" data-name=\"nav actions buttons container\">\n<button class=\"cart-btn\" data-kid=\"1-1-1-3-1\" data-name=\"shopping cart button\" type=\"button\"><i class=\"icon-shopping-cart\" data-kid=\"1-1-1-3-1-1\" data-name=\"shopping cart icon\"></i><span data-kid=\"1-1-1-3-1-2\" data-name=\"cart button label with item count\">عربة التسوق (5)</span></button>\n<button class=\"acct-btn\" data-kid=\"1-1-1-3-2\" data-name=\"account button\" type=\"button\"><i class=\"icon-user\" data-kid=\"1-1-1-3-2-1\" data-name=\"user icon\"></i><span data-kid=\"1-1-1-3-2-2\" data-name=\"account button label\">حسابك</span></button>\n</div>\n</header>\n<section class=\"band\" data-kid=\"1-1-2\" data-name=\"search and actions band\">\n<h1 data-kid=\"1-1-2-1\" data-name=\"page title heading\">المنتجات</h1>\n<div class=\"searchbox\" data-kid=\"1-1-2-2\" data-name=\"product search box\">\n<i class=\"icon-search\" data-kid=\"1-1-2-2-1\" data-name=\"search magnifier icon\"></i>\n<input aria-label=\"البحث عن دواء\" data-kid=\"1-1-2-2-2\" data-name=\"search input field\" placeholder=\"ابحث باسم الدواء أو المادة الفعالة\" type=\"text\"/>\n<button data-kid=\"1-1-2-2-3\" data-name=\"search submit button\" type=\"button\">بحث</button>\n</div>\n<button class=\"area-btn\" data-kid=\"1-1-2-3\" data-name=\"delivery area selector button\" type=\"button\">\n<i class=\"icon-map-pin\" data-kid=\"1-1-2-3-1\" data-name=\"map pin icon\"></i><span data-kid=\"1-1-2-3-2\" data-name=\"selected area label\">الحي السابع، مدينة نصر</span><i class=\"icon-chevron-down\" data-kid=\"1-1-2-3-3\" data-name=\"chevron down icon\"></i>\n</button>\n<button class=\"rx-btn\" data-kid=\"1-1-2-4\" data-name=\"upload prescription button\" type=\"button\">\n<i class=\"icon-upload\" data-kid=\"1-1-2-4-1\" data-name=\"upload icon\"></i><span data-kid=\"1-1-2-4-2\" data-name=\"prescription upload label\">رفع روشتة</span>\n</button>\n</section>\n<div class=\"cats\" data-kid=\"1-1-3\" data-name=\"category filters grid\">\n<button class=\"cat active\" data-kid=\"1-1-3-1\" data-name=\"category button medications (active)\" type=\"button\"><i class=\"icon-pill\" data-kid=\"1-1-3-1-1\" data-name=\"pill icon\"></i>الأدوية</button>\n<button class=\"cat\" data-kid=\"1-1-3-2\" data-name=\"category button skin care\" type=\"button\"><i class=\"icon-sparkles\" data-kid=\"1-1-3-2-1\" data-name=\"sparkles icon\"></i>عناية بالبشرة</button>\n<button class=\"cat\" data-kid=\"1-1-3-3\" data-name=\"category button vitamins\" type=\"button\"><i class=\"icon-heart-pulse\" data-kid=\"1-1-3-3-1\" data-name=\"heart pulse icon\"></i>الفيتامينات</button>\n<button class=\"cat\" data-kid=\"1-1-3-4\" data-name=\"category button medical devices\" type=\"button\"><i class=\"icon-stethoscope\" data-kid=\"1-1-3-4-1\" data-name=\"stethoscope icon\"></i>أجهزة طبية</button>\n<button class=\"cat\" data-kid=\"1-1-3-5\" data-name=\"category button first aid\" type=\"button\"><i class=\"icon-bandage\" data-kid=\"1-1-3-5-1\" data-name=\"bandage icon\"></i>إسعافات أولية</button>\n</div>\n<div class=\"content\" data-kid=\"1-1-4\" data-name=\"two column content layout\">\n<section aria-label=\"كتالوج الأدوية\" class=\"catalog\" data-kid=\"1-1-4-1\" data-name=\"product catalog section\">\n<div class=\"catalog-head\" data-kid=\"1-1-4-1-1\" data-name=\"catalog header row\">\n<h2 data-kid=\"1-1-4-1-1-1\" data-name=\"catalog section title\">الأدوية</h2>\n<span data-kid=\"1-1-4-1-1-2\" data-name=\"product count label\">10 منتجات</span>\n</div>\n<div class=\"columns\" data-kid=\"1-1-4-1-2\" data-name=\"catalog column header row\">\n<span data-kid=\"1-1-4-1-2-1\" data-name=\"column header product\">المنتج</span>\n<span data-kid=\"1-1-4-1-2-2\" data-name=\"column header active ingredient\">المادة الفعالة</span>\n<span data-kid=\"1-1-4-1-2-3\" data-name=\"column header concentration form\">التركيز والشكل</span>\n<span data-kid=\"1-1-4-1-2-4\" data-name=\"column header packaging\">العبوة</span>\n<span data-kid=\"1-1-4-1-2-5\" data-name=\"column header price\">السعر</span>\n<span data-kid=\"1-1-4-1-2-6\" data-name=\"column header action (empty)\"></span>\n</div>\n<div class=\"row\" data-kid=\"1-1-4-1-3\" data-name=\"product row Panadol\">\n<span class=\"p-name\" data-kid=\"1-1-4-1-3-1\" data-name=\"product name Panadol\">بانادول</span>\n<span data-kid=\"1-1-4-1-3-2\" data-name=\"product active ingredient\">باراسيتامول</span>\n<span data-kid=\"1-1-4-1-3-3\" data-name=\"product concentration and form\">500 مج · أقراص</span>\n<span data-kid=\"1-1-4-1-3-4\" data-name=\"product packaging info\">عبوة 20 قرص</span>\n<span class=\"p-price\" data-kid=\"1-1-4-1-3-5\" data-name=\"product price\">35 ج.م</span>\n<button class=\"add-btn\" data-kid=\"1-1-4-1-3-6\" data-name=\"add to cart button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-4-1-3-6-1\" data-name=\"plus icon\"></i>إضافة للعربة</button>\n</div>\n<div class=\"row\" data-kid=\"1-1-4-1-4\" data-name=\"product row Ebimol\">\n<span class=\"p-name\" data-kid=\"1-1-4-1-4-1\" data-name=\"product name Ebimol\">أبيمول</span>\n<span data-kid=\"1-1-4-1-4-2\" data-name=\"product active ingredient\">باراسيتامول</span>\n<span data-kid=\"1-1-4-1-4-3\" data-name=\"product concentration and form\">500 مج · أقراص</span>\n<span data-kid=\"1-1-4-1-4-4\" data-name=\"product packaging info\">عبوة 20 قرص</span>\n<span class=\"p-price\" data-kid=\"1-1-4-1-4-5\" data-name=\"product price\">28 ج.م</span>\n<button class=\"add-btn\" data-kid=\"1-1-4-1-4-6\" data-name=\"add to cart button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-4-1-4-6-1\" data-name=\"plus icon\"></i>إضافة للعربة</button>\n</div>\n<div class=\"row\" data-kid=\"1-1-4-1-5\" data-name=\"product row Congestal\">\n<span class=\"p-name\" data-kid=\"1-1-4-1-5-1\" data-name=\"product name Congestal\">كونجستال</span>\n<span data-kid=\"1-1-4-1-5-2\" data-name=\"product active ingredient\">تركيبة متعددة المكونات</span>\n<span data-kid=\"1-1-4-1-5-3\" data-name=\"product concentration and form\">حسب العبوة · أقراص</span>\n<span data-kid=\"1-1-4-1-5-4\" data-name=\"product packaging info\">عبوة أقراص</span>\n<span class=\"p-price\" data-kid=\"1-1-4-1-5-5\" data-name=\"product price\">42 ج.م</span>\n<button class=\"add-btn\" data-kid=\"1-1-4-1-5-6\" data-name=\"add to cart button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-4-1-5-6-1\" data-name=\"plus icon\"></i>إضافة للعربة</button>\n</div>\n<div class=\"row\" data-kid=\"1-1-4-1-6\" data-name=\"product row Brufen\">\n<span class=\"p-name\" data-kid=\"1-1-4-1-6-1\" data-name=\"product name Brufen\">بروفين</span>\n<span data-kid=\"1-1-4-1-6-2\" data-name=\"product active ingredient\">إيبوبروفين</span>\n<span data-kid=\"1-1-4-1-6-3\" data-name=\"product concentration and form\">400 مج · أقراص</span>\n<span data-kid=\"1-1-4-1-6-4\" data-name=\"product packaging info\">عبوة أقراص</span>\n<span class=\"p-price\" data-kid=\"1-1-4-1-6-5\" data-name=\"product price\">45 ج.م</span>\n<button class=\"add-btn\" data-kid=\"1-1-4-1-6-6\" data-name=\"add to cart button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-4-1-6-6-1\" data-name=\"plus icon\"></i>إضافة للعربة</button>\n</div>\n<div class=\"row\" data-kid=\"1-1-4-1-7\" data-name=\"product row Zertec\">\n<span class=\"p-name\" data-kid=\"1-1-4-1-7-1\" data-name=\"product name Zertec\">زيرتك</span>\n<span data-kid=\"1-1-4-1-7-2\" data-name=\"product active ingredient\">سيتريزين</span>\n<span data-kid=\"1-1-4-1-7-3\" data-name=\"product concentration and form\">10 مج · أقراص</span>\n<span data-kid=\"1-1-4-1-7-4\" data-name=\"product packaging info\">عبوة أقراص</span>\n<span class=\"p-price\" data-kid=\"1-1-4-1-7-5\" data-name=\"product price\">55 ج.م</span>\n<button class=\"add-btn\" data-kid=\"1-1-4-1-7-6\" data-name=\"add to cart button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-1-4-1-7-6-1\" data-name=\"plus icon\"></i>إضافة للعربة</button>\n</div>\n<button class=\"more\" data-kid=\"1-1-4-1-8\" data-name=\"load more products button\" type=\"button\">عرض المزيد<i class=\"icon-chevron-down\" data-kid=\"1-1-4-1-8-1\" data-name=\"chevron down icon\"></i></button>\n</section>\n<aside aria-label=\"ملخص العربة\" class=\"summary\" data-kid=\"1-1-4-2\" data-name=\"shopping cart summary panel\">\n<div class=\"sum-head\" data-kid=\"1-1-4-2-1\" data-name=\"cart summary header\">\n<h2 data-kid=\"1-1-4-2-1-1\" data-name=\"cart title\">العربة</h2>\n<span data-kid=\"1-1-4-2-1-2\" data-name=\"cart items count\">5 وحدات</span>\n</div>\n<div class=\"sum-item\" data-kid=\"1-1-4-2-2\" data-name=\"cart line item Panadol\"><strong data-kid=\"1-1-4-2-2-1\" data-name=\"cart item name\">بانادول</strong><span class=\"q\" data-kid=\"1-1-4-2-2-2\" data-name=\"cart item quantity\">×1</span><span class=\"t\" data-kid=\"1-1-4-2-2-3\" data-name=\"cart item line total\">37 ج.م</span></div>\n<div class=\"sum-item\" data-kid=\"1-1-4-2-3\" data-name=\"cart line item Brufen\"><strong data-kid=\"1-1-4-2-3-1\" data-name=\"cart item name\">بروفين</strong><span class=\"q\" data-kid=\"1-1-4-2-3-2\" data-name=\"cart item quantity\">×2</span><span class=\"t\" data-kid=\"1-1-4-2-3-3\" data-name=\"cart item line total\">92 ج.م</span></div>\n<div class=\"sum-item\" data-kid=\"1-1-4-2-4\" data-name=\"cart line item Bepanthen\"><strong data-kid=\"1-1-4-2-4-1\" data-name=\"cart item name\">بيبانثين</strong><span class=\"q\" data-kid=\"1-1-4-2-4-2\" data-name=\"cart item quantity\">×1</span><span class=\"t\" data-kid=\"1-1-4-2-4-3\" data-name=\"cart item line total\">92 ج.م</span></div>\n<div class=\"sum-item\" data-kid=\"1-1-4-2-5\" data-name=\"cart line item Vitamin C\"><strong data-kid=\"1-1-4-2-5-1\" data-name=\"cart item name\">فيتامين سي</strong><span class=\"q\" data-kid=\"1-1-4-2-5-2\" data-name=\"cart item quantity\">×1</span><span class=\"t\" data-kid=\"1-1-4-2-5-3\" data-name=\"cart item line total\">124 ج.م</span></div>\n<div class=\"sum-totals\" data-kid=\"1-1-4-2-6\" data-name=\"cart totals section\">\n<div class=\"t-row\" data-kid=\"1-1-4-2-6-1\" data-name=\"subtotal row\"><span data-kid=\"1-1-4-2-6-1-1\" data-name=\"subtotal label\">المجموع</span><strong data-kid=\"1-1-4-2-6-1-2\" data-name=\"subtotal value\">345 ج.م</strong></div>\n<div class=\"t-row\" data-kid=\"1-1-4-2-6-2\" data-name=\"delivery fee row\"><span data-kid=\"1-1-4-2-6-2-1\" data-name=\"delivery fee label\">التوصيل</span><strong data-kid=\"1-1-4-2-6-2-2\" data-name=\"delivery fee value\">30 ج.م</strong></div>\n<div class=\"t-row grand\" data-kid=\"1-1-4-2-6-3\" data-name=\"grand total row\"><span data-kid=\"1-1-4-2-6-3-1\" data-name=\"grand total label\">الإجمالي</span><strong data-kid=\"1-1-4-2-6-3-2\" data-name=\"grand total value\">375 ج.م</strong></div>\n</div>\n<button class=\"checkout-btn\" data-kid=\"1-1-4-2-7\" data-name=\"checkout button\" type=\"button\">إتمام الطلب<i class=\"icon-arrow-left\" data-kid=\"1-1-4-2-7-1\" data-name=\"arrow left icon\"></i></button>\n</aside>\n</div>\n<footer class=\"footer\" data-kid=\"1-1-5\" data-name=\"site footer\">\n<span class=\"footer-brand\" data-kid=\"1-1-5-1\" data-name=\"footer brand with logo and copyright\">\n<img alt=\"شعار دواك\" data-kid=\"1-1-5-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n        دواك 2026\n      </span>\n<div class=\"links\" data-kid=\"1-1-5-2\" data-name=\"footer links container\">\n<a data-kid=\"1-1-5-2-1\" data-name=\"footer link about\" href=\"#\" style=\"color:#6b857f;text-decoration:none;font-weight:700\">عن دواك</a>\n<a data-kid=\"1-1-5-2-2\" data-name=\"footer link privacy policy\" href=\"#\" style=\"color:#6b857f;text-decoration:none;font-weight:700\">سياسة الخصوصية</a>\n<a data-kid=\"1-1-5-2-3\" data-name=\"footer link terms of service\" href=\"#\" style=\"color:#6b857f;text-decoration:none;font-weight:700\">الشروط والأحكام</a>\n<a data-kid=\"1-1-5-2-4\" data-name=\"footer link contact us\" href=\"#\" style=\"color:#6b857f;text-decoration:none;font-weight:700\">اتصل بنا</a>\n</div>\n</footer>\n</div>\n</div>",
