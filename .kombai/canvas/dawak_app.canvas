      "html": "<div class=\"dw\" data-kid=\"1\" data-name=\"page layout container\" dir=\"rtl\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --green:#075e50;--green-dark:#06483f;--green-deep:#043e37;--bright:#16a783;\n  --mint:#e1f4ed;--mint-2:#f0faf6;--amber:#f5a12a;--ink:#123d38;--muted:#708783;\n  --border:#dcebe6;--line:#edf4f1;\n}\n*{box-sizing:border-box}\nbody{margin:0}\n.dw{background:#f6fbf9;color:var(--ink);font-family:'Cairo','Inter',sans-serif;font-size:14px;direction:rtl;min-height:100vh}\n.num{font-family:'Inter','Cairo',sans-serif;font-variant-numeric:tabular-nums}\n.wrap{max-width:1128px;margin:0 auto;padding:0 24px}\na{text-decoration:none;color:inherit}\nbutton{font:inherit;cursor:pointer;border:0;background:none;color:inherit}\ni{font-style:normal;line-height:1}\n\n/* ---------- top bar ---------- */\n.topbar{background:#fff;border-bottom:1px solid var(--border)}\n.bar{height:78px;display:flex;align-items:center;gap:18px}\n.brand{display:flex;align-items:center;gap:9px;flex:0 0 auto}\n.logo-img{width:42px;height:42px;object-fit:contain;mix-blend-mode:multiply;border-radius:10px}\n.brand-txt{display:flex;flex-direction:column;line-height:1.1}\n.brand-txt b{font-family:'Inter',sans-serif;font-size:17px;letter-spacing:.7px;color:var(--green-deep);font-weight:800}\n.brand-txt span{font-size:10.5px;color:var(--muted);font-weight:600;margin-top:3px}\n.links{display:flex;align-items:center;gap:19px;flex:1;padding-inline-start:14px}\n.links a{font-size:12.5px;font-weight:700;color:#456a62;padding:8px 0 6px;border-bottom:2px solid transparent}\n.links a.active{color:var(--green);border-bottom-color:var(--bright)}\n.bar-actions{display:flex;align-items:center;gap:8px}\n.pill-btn{display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 11px;border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--green-dark);font-size:11.5px;font-weight:700;white-space:nowrap}\n.pill-btn i{font-size:15px;color:#6e8d85}\n.icon-only{width:38px;padding:0;justify-content:center}\n.cart-btn{background:var(--green);border-color:var(--green);color:#fff}\n.cart-btn i{color:#bfe6d9}\n.cart-count{min-width:18px;height:18px;border-radius:9px;background:rgba(255,255,255,.18);display:inline-grid;place-items:center;font-size:10px;font-weight:700;padding:0 4px}\n\n/* ---------- finder ---------- */\n.finder{display:grid;grid-template-columns:minmax(0,1fr) 376px;gap:24px;padding-top:26px}\n.f-card{background:#fff;border:1px solid var(--border);border-radius:18px;padding:24px;box-shadow:0 10px 30px rgba(6,72,63,.05)}\n.finder h1{margin:0 0 16px;font-size:30px;font-weight:800;color:var(--green-deep);letter-spacing:-.3px}\n.searchbox{display:flex;align-items:center;gap:10px;height:58px;padding:6px 6px 6px 16px;border:1px solid #cfe4dc;border-radius:14px;background:#fff}\n.searchbox>i{font-size:19px;color:#86a49b;flex:0 0 auto}\n.searchbox input{flex:1;min-width:0;border:0;outline:0;font:inherit;font-size:14px;color:var(--ink);background:transparent}\n.searchbox input::placeholder{color:#9db3ac}\n.search-go{height:44px;padding:0 26px;border-radius:10px;background:var(--green);color:#fff;font-size:13.5px;font-weight:800;flex:0 0 auto}\n.loc-row{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:14px;padding-top:14px;border-top:1px solid var(--line)}\n.loc{display:flex;align-items:center;gap:7px;font-size:12px;color:#5c7c74;font-weight:600}\n.loc i{font-size:16px;color:var(--bright)}\n.text-btn{font-size:12px;font-weight:800;color:var(--green);display:inline-flex;align-items:center;gap:5px}\n.text-btn i{font-size:13px}\n\n.rx{background:var(--mint-2);border:1px solid #d7ece4;border-radius:18px;padding:18px;display:flex;flex-direction:column;gap:11px}\n.rx-head{display:flex;align-items:flex-start;gap:11px}\n.rx-icon{width:38px;height:38px;flex:0 0 38px;border-radius:11px;background:#fff;border:1px solid #d9ece5;display:grid;place-items:center;color:var(--green);font-size:19px}\n.rx h2{margin:0 0 3px;font-size:16px;font-weight:800;color:var(--green-deep)}\n.rx p{margin:0;font-size:11.5px;line-height:1.7;color:#5e7d75}\n.rx-drop{display:flex;align-items:center;justify-content:center;gap:8px;min-height:58px;border:1.5px dashed #b3d8cb;border-radius:12px;background:#fff;color:var(--green-dark);font-size:11.5px;font-weight:700;padding:8px}\n.rx-drop i{font-size:18px;color:var(--bright)}\n.fine{margin:0;font-size:10.5px;line-height:1.6;color:#7b948c}\n\n/* ---------- categories ---------- */\n.cats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:18px;padding:8px;background:#fff;border:1px solid var(--border);border-radius:16px}\n.cat{display:flex;align-items:center;justify-content:center;gap:8px;height:56px;border-radius:11px;font-size:12.5px;font-weight:700;color:#47695f;border:1px solid transparent}\n.cat i{font-size:18px;color:#87a49a}\n.cat.on{background:var(--mint);border-color:#b9e2d5;color:var(--green-deep)}\n.cat.on i{color:var(--green)}\n\n/* ---------- catalog ---------- */\n.catalog{margin-top:24px}\n.cat-head{display:flex;align-items:baseline;gap:10px;margin-bottom:12px}\n.cat-head h2{margin:0;font-size:19px;font-weight:800;color:var(--green-deep)}\n.cat-head span{font-size:11.5px;color:var(--muted);font-weight:600}\n.grid-wrap{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:hidden}\n.grid-head,.prow{display:grid;grid-template-columns:minmax(0,1fr) 200px 128px 92px 236px;gap:14px;align-items:center;padding:0 18px}\n.grid-head{height:40px;background:#fbfefc;border-bottom:1px solid var(--line);font-size:11px;font-weight:700;color:#8aa29b}\n.prow{min-height:76px;border-bottom:1px solid var(--line)}\n.prow:last-child{border-bottom:0}\n.prow:hover{background:#fbfefc}\n.pname{display:flex;align-items:center;gap:11px;min-width:0}\n.tile{width:38px;height:38px;flex:0 0 38px;border-radius:10px;background:var(--mint-2);display:grid;place-items:center;color:var(--green);font-size:18px}\n.pname b{font-size:14px;font-weight:800;color:var(--green-deep);display:block}\n.pname em{font-style:normal;display:block;font-size:10.5px;color:#8a9f99;margin-top:2px}\n.pmeta{font-size:11.5px;color:#5f7d75;line-height:1.6}\n.pprice{font-size:14px;font-weight:800;color:var(--green-dark);white-space:nowrap}\n.pprice small{font-size:10px;font-weight:700;color:var(--muted);margin-inline-start:2px}\n.pactions{display:flex;align-items:center;justify-content:flex-end;gap:8px}\n.btn-view{height:36px;padding:0 2px;border-radius:9px;background:transparent;color:var(--green);font-size:11.5px;font-weight:800;display:inline-flex;align-items:center;gap:4px;white-space:nowrap}\n.btn-view:hover{color:var(--green-dark);text-decoration:underline}\n.btn-view i{font-size:13px;color:var(--green)}\n.btn-add{height:36px;padding:0 12px;border-radius:9px;border:1px solid #cfe6dd;background:#f4fbf8;color:var(--green);font-size:11.5px;font-weight:800;display:inline-flex;align-items:center;gap:5px;white-space:nowrap}\n.btn-add i{font-size:14px}\n.more{display:block;margin:18px auto 0;height:44px;padding:0 26px;border:1px solid #cfe6dd;border-radius:11px;background:#fff;color:var(--green-dark);font-weight:800;font-size:12.5px}\n\n/* ---------- service strip ---------- */\n.strip{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden;margin-top:26px}\n.strip div{background:#fff;padding:14px 16px;display:flex;align-items:center;gap:9px;font-size:11.5px;color:#54736b;font-weight:600}\n.strip i{font-size:17px;color:var(--bright)}\n.strip strong{margin-inline-start:auto;font-size:12px;font-weight:800;color:var(--green-deep)}\n\n/* ---------- footer ---------- */\n.foot{margin-top:26px;background:#fff;border-top:1px solid var(--border)}\n.foot-in{height:76px;display:flex;align-items:center;justify-content:space-between;gap:16px}\n.foot-links{display:flex;align-items:center;gap:20px}\n.foot a,.foot span{font-size:11.5px;color:#5f7d75;font-weight:600}\n.foot-brand{display:flex;align-items:center;gap:8px;color:var(--green-deep);font-weight:800;font-size:12.5px}\n.foot-brand img{width:26px;height:26px;object-fit:contain;mix-blend-mode:multiply}\n</style>\n<header class=\"topbar\" data-kid=\"1-1\" data-name=\"top site header bar\">\n<div class=\"wrap bar\" data-kid=\"1-1-1\" data-name=\"header content row\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#\">\n<img alt=\"شعار دواك\" class=\"logo-img\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-txt\" data-kid=\"1-1-1-1-2\" data-name=\"brand text group\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"brand name (DAWAK)\">DAWAK</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand Arabic tagline\">دواك · صيدليتك أونلاين</span></span>\n</a>\n<nav class=\"links\" data-kid=\"1-1-1-2\" data-name=\"primary navigation links\">\n<a class=\"active\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link: home (active)\" href=\"#\">الرئيسية</a>\n<a data-kid=\"1-1-1-2-2\" data-name=\"navigation link: products\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"navigation link: pharmacist consultation\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"navigation link: FAQ\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"navigation link: contact us\" href=\"#\">اتصل بنا</a>\n</nav>\n<div class=\"bar-actions\" data-kid=\"1-1-1-3\" data-name=\"header actions group\">\n<button class=\"pill-btn\" data-kid=\"1-1-1-3-1\" data-name=\"selected area indicator button\" type=\"button\"><i class=\"icon-map-pin\" data-kid=\"1-1-1-3-1-1\" data-name=\"map pin icon\"></i>الحي السابع</button>\n<button aria-label=\"حسابك\" class=\"pill-btn icon-only\" data-kid=\"1-1-1-3-2\" data-name=\"account user icon button\" type=\"button\"><i class=\"icon-user-round\" data-kid=\"1-1-1-3-2-1\" data-name=\"user profile icon\"></i></button>\n<button class=\"pill-btn cart-btn\" data-kid=\"1-1-1-3-3\" data-name=\"shopping cart button\" type=\"button\"><i class=\"icon-shopping-bag\" data-kid=\"1-1-1-3-3-1\" data-name=\"shopping bag icon\"></i>العربة<span class=\"cart-count num\" data-kid=\"1-1-1-3-3-2\" data-name=\"cart item count badge\">4</span></button>\n</div>\n</div>\n</header>\n<main class=\"wrap\" data-kid=\"1-2\" data-name=\"main content container\">\n<section class=\"finder\" data-kid=\"1-2-1\" data-name=\"finder section\">\n<div class=\"f-card\" data-kid=\"1-2-1-1\" data-name=\"medicine search card\">\n<h1 data-kid=\"1-2-1-1-1\" data-name=\"search card heading\">ابحث عن دواء</h1>\n<div class=\"searchbox\" data-kid=\"1-2-1-1-2\" data-name=\"medicine search input row\">\n<i class=\"icon-search\" data-kid=\"1-2-1-1-2-1\" data-name=\"search magnifier icon\"></i>\n<input data-kid=\"1-2-1-1-2-2\" data-name=\"medicine search text input\" placeholder=\"اسم الدواء أو المادة الفعالة\" type=\"text\"/>\n<button class=\"search-go\" data-kid=\"1-2-1-1-2-3\" data-name=\"search submit button\" type=\"button\">بحث</button>\n</div>\n<div class=\"loc-row\" data-kid=\"1-2-1-1-3\" data-name=\"location selection row\">\n<span class=\"loc\" data-kid=\"1-2-1-1-3-1\" data-name=\"current location display\"><i class=\"icon-map-pin\" data-kid=\"1-2-1-1-3-1-1\" data-name=\"map pin icon\"></i>الحي السابع، مدينة نصر، القاهرة</span>\n<button class=\"text-btn\" data-kid=\"1-2-1-1-3-2\" data-name=\"change location button\" type=\"button\">تغيير المنطقة<i class=\"icon-chevron-left\" data-kid=\"1-2-1-1-3-2-1\" data-name=\"left chevron icon\"></i></button>\n</div>\n</div>\n<aside class=\"rx\" data-kid=\"1-2-1-2\" data-name=\"rx prescription upload aside\">\n<div class=\"rx-head\" data-kid=\"1-2-1-2-1\" data-name=\"rx card header\">\n<span class=\"rx-icon\" data-kid=\"1-2-1-2-1-1\" data-name=\"rx icon container\"><i class=\"icon-file-text\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"document file icon\"></i></span>\n<div data-kid=\"1-2-1-2-1-2\" data-name=\"rx header text group\">\n<h2 data-kid=\"1-2-1-2-1-2-1\" data-name=\"rx card title\">الروشتة</h2>\n<p data-kid=\"1-2-1-2-1-2-2\" data-name=\"rx card description\">صورة أو PDF يطّلع عليها الصيدلي قبل التجهيز.</p>\n</div>\n</div>\n<button class=\"rx-drop\" data-kid=\"1-2-1-2-2\" data-name=\"rx file dropzone button\" type=\"button\"><i class=\"icon-upload-cloud\" data-kid=\"1-2-1-2-2-1\" data-name=\"cloud upload icon\"></i>لم يتم اختيار ملف</button>\n<p class=\"fine\" data-kid=\"1-2-1-2-3\" data-name=\"rx accepted formats note\" style=\"margin-top:auto\">صيغ الملفات: JPG أو PNG أو PDF</p>\n<p class=\"fine\" data-kid=\"1-2-1-2-4\" data-name=\"rx availability disclaimer\">إرسال الروشتة غير متاح في هذا الإصدار.</p>\n</aside>\n</section>\n<section aria-label=\"الأقسام\" class=\"cats\" data-kid=\"1-2-2\" data-name=\"category filter section\">\n<button class=\"cat on\" data-kid=\"1-2-2-1\" data-name=\"category button: medicines (active)\" type=\"button\"><i class=\"icon-pill\" data-kid=\"1-2-2-1-1\" data-name=\"pill icon\"></i>الأدوية</button>\n<button class=\"cat\" data-kid=\"1-2-2-2\" data-name=\"category button: skincare\" type=\"button\"><i class=\"icon-sparkles\" data-kid=\"1-2-2-2-1\" data-name=\"sparkles icon\"></i>عناية بالبشرة</button>\n<button class=\"cat\" data-kid=\"1-2-2-3\" data-name=\"category button: vitamins\" type=\"button\"><i class=\"icon-heart-pulse\" data-kid=\"1-2-2-3-1\" data-name=\"heart pulse icon\"></i>الفيتامينات</button>\n<button class=\"cat\" data-kid=\"1-2-2-4\" data-name=\"category button: medical devices\" type=\"button\"><i class=\"icon-stethoscope\" data-kid=\"1-2-2-4-1\" data-name=\"stethoscope icon\"></i>أجهزة طبية</button>\n<button class=\"cat\" data-kid=\"1-2-2-5