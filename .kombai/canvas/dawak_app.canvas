      "html": "<div class=\"dw\" data-kid=\"1\" data-name=\"RTL page layout container\" dir=\"rtl\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --green:#075e50;--green-dark:#06483f;--green-deep:#043e37;--bright:#16a783;\n  --mint:#e1f4ed;--mint-2:#f0faf6;--amber:#f5a12a;--ink:#123d38;--muted:#708783;\n  --border:#dcebe6;--line:#edf4f1;\n}\n*{box-sizing:border-box}\nbody{margin:0}\n.dw{background:#f6fbf9;color:var(--ink);font-family:'Cairo','Inter',sans-serif;font-size:14px;direction:rtl;min-height:100vh}\n.num{font-family:'Inter','Cairo',sans-serif;font-variant-numeric:tabular-nums}\n.wrap{max-width:1128px;margin:0 auto;padding:0 24px}\na{text-decoration:none;color:inherit}\nbutton{font:inherit;cursor:pointer;border:0;background:none;color:inherit}\ni{font-style:normal;line-height:1}\n\n/* top bar */\n.topbar{background:#fff;border-bottom:1px solid var(--border)}\n.bar{height:78px;display:flex;align-items:center;gap:18px}\n.brand{display:flex;align-items:center;gap:9px;flex:0 0 auto}\n.logo-img{width:42px;height:42px;object-fit:contain;mix-blend-mode:multiply;border-radius:10px}\n.brand-txt{display:flex;flex-direction:column;line-height:1.1}\n.brand-txt b{font-family:'Inter',sans-serif;font-size:17px;letter-spacing:.7px;color:var(--green-deep);font-weight:800}\n.brand-txt span{font-size:10.5px;color:var(--muted);font-weight:600;margin-top:3px}\n.links{display:flex;align-items:center;gap:19px;flex:1;padding-inline-start:14px}\n.links a{font-size:12.5px;font-weight:700;color:#456a62;padding:8px 0 6px;border-bottom:2px solid transparent}\n.links a.active{color:var(--green);border-bottom-color:var(--bright)}\n.bar-actions{display:flex;align-items:center;gap:8px}\n.pill-btn{display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 11px;border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--green-dark);font-size:11.5px;font-weight:700;white-space:nowrap}\n.pill-btn i{font-size:15px;color:#6e8d85}\n.icon-only{width:38px;padding:0;justify-content:center}\n.cart-btn{background:var(--green);border-color:var(--green);color:#fff}\n.cart-btn i{color:#bfe6d9}\n.cart-count{min-width:18px;height:18px;border-radius:9px;background:rgba(255,255,255,.18);display:inline-grid;place-items:center;font-size:10px;font-weight:700;padding:0 4px}\n\n/* steps + title */\n.steps{display:flex;align-items:center;gap:10px;padding-top:20px;font-size:11.5px;font-weight:700;color:#7d948d}\n.step{display:inline-flex;align-items:center;gap:6px}\n.step .dot{width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:11px}\n.step.done{color:var(--green)}\n.step.done .dot{background:var(--mint);color:var(--green)}\n.step.current{color:var(--green-deep);font-weight:800}\n.step.current .dot{background:var(--green);color:#fff;font-size:10.5px}\n.sep{width:40px;height:1px;background:#cfe4dc}\n.page-title{margin:12px 0 18px;font-size:26px;font-weight:800;color:var(--green-deep);letter-spacing:-.2px}\n\n/* layout */\n.cols{display:grid;grid-template-columns:656px 396px;gap:28px;align-items:start;padding-bottom:6px}\n.panel{background:#fff;border:1px solid var(--border);border-radius:16px;padding:20px}\n.panel + .panel{margin-top:18px}\n.panel-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}\n.panel-head h2{margin:0;font-size:15px;font-weight:800;color:var(--green-deep)}\n.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}\n.fields label{display:grid;gap:6px;font-size:11.5px;font-weight:700;color:#4d6d65}\n.fields label.full{grid-column:1 / -1}\n.fields input,.fields textarea{width:100%;min-width:0;height:46px;padding:0 12px;border:1px solid #d5e5df;border-radius:10px;background:#fff;font:inherit;font-size:13px;color:var(--ink);outline:none}\n.fields textarea{height:auto;min-height:78px;padding:11px 12px;resize:none;line-height:1.7}\n.fields input::placeholder,.fields textarea::placeholder{color:#a3b5af}\n.fields input:focus,.fields textarea:focus{border-color:var(--bright);box-shadow:0 0 0 3px rgba(22,167,131,.1)}\n\n.pharm{display:flex;align-items:center;gap:11px;padding:12px;border:1px solid var(--line);border-radius:12px;background:#fbfefc}\n.pharm-tile{width:38px;height:38px;flex:0 0 38px;border-radius:10px;background:var(--mint);display:grid;place-items:center;color:var(--green);font-size:18px}\n.pharm b{display:block;font-size:12.5px;font-weight:800;color:var(--green-deep)}\n.pharm span{display:block;font-size:10.5px;color:#7d948d;margin-top:2px}\n.stock-ok{margin-inline-start:auto;display:inline-flex;align-items:center;gap:5px;font-size:10.5px;font-weight:800;color:#16835f;white-space:nowrap}\n.stock-ok i{font-size:14px}\n.delivery{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:12px;overflow:hidden;margin-top:12px}\n.delivery div{background:#fff;padding:11px 12px}\n.delivery span{display:block;font-size:10.5px;color:#8aa29b;font-weight:600;margin-bottom:3px}\n.delivery strong{font-size:12.5px;font-weight:800;color:var(--green-dark)}\n.delivery small{font-size:9.5px;color:#9db3ac;font-weight:600;margin-inline-start:3px}\n.confirm{width:100%;height:48px;margin-top:16px;border-radius:11px;background:var(--green);color:#fff;font-size:13.5px;font-weight:800}\n.confirm:hover{background:var(--green-dark)}\n.fine{margin:9px 0 0;font-size:10px;line-height:1.6;color:#84998f;text-align:center}\n.link{font-size:11px;font-weight:800;color:var(--green);white-space:nowrap}\n\n/* summary */\n.summary{background:#fff;border:1px solid var(--border);border-radius:16px;padding:20px}\n.sum-head{display:flex;align-items:center;justify-content:space-between;gap:10px;padding-bottom:12px;border-bottom:1px solid var(--line)}\n.sum-head h2{margin:0;font-size:15px;font-weight:800;color:var(--green-deep)}\n.items{list-style:none;margin:0;padding:0}\n.items li{display:grid;grid-template-columns:minmax(0,1fr) 28px 76px;gap:8px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}\n.items b{display:block;font-size:12.5px;font-weight:800;color:var(--green-deep)}\n.items .sub{display:block;font-size:10px;color:#8a9f99;margin-top:2px}\n.items .q{font-size:11px;font-weight:700;color:#5f7d75;text-align:center}\n.items .lt{font-size:12px;font-weight:800;color:var(--green-dark);text-align:left}\n.footer-note{display:flex;align-items:center;gap:6px;margin:11px 0 0;font-size:10.5px;font-weight:600;color:#7d948d}\n.footer-note i{font-size:13px;color:var(--bright)}\n.totals{display:grid;gap:9px;margin-top:12px}\n.totals div{display:flex;align-items:center;justify-content:space-between;font-size:11.5px;color:#5f7d75;font-weight:600}\n.totals strong{font-size:12px;color:var(--green-dark);font-weight:700}\n.totals .grand{border-top:1px solid var(--line);padding-top:11px;margin-top:2px;font-size:13.5px;color:var(--green-deep);font-weight:800}\n.totals .grand strong{font-size:15px;color:var(--green-deep);font-weight:800}\n.sum-note{display:flex;align-items:flex-start;gap:6px;margin:12px 0 0;padding-top:11px;border-top:1px solid var(--line);font-size:10px;line-height:1.7;color:#7d948d}\n.sum-note i{font-size:13px;margin-top:2px;color:#9db3ac;flex:0 0 auto}\n\n/* footer */\n.foot{margin-top:22px;background:#fff;border-top:1px solid var(--border)}\n.foot-in{height:76px;display:flex;align-items:center;justify-content:space-between;gap:16px}\n.foot-links{display:flex;align-items:center;gap:20px}\n.foot a,.foot span{font-size:11.5px;color:#5f7d75;font-weight:600}\n.foot-brand{display:flex;align-items:center;gap:8px;color:var(--green-deep);font-weight:800;font-size:12.5px}\n.foot-brand img{width:26px;height:26px;object-fit:contain;mix-blend-mode:multiply}\n</style>\n<header class=\"topbar\" data-kid=\"1-1\" data-name=\"site top navigation bar\">\n<div class=\"wrap bar\" data-kid=\"1-1-1\" data-name=\"top bar inner container\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"شعار دواك\" class=\"logo-img\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-txt\" data-kid=\"1-1-1-1-2\" data-name=\"brand name block\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">DAWAK</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline subtitle\">دواك · صيدليتك أونلاين</span></span>\n</a>\n<nav class=\"links\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"homepage nav link\" href=\"#\">الرئيسية</a>\n<a data-kid=\"1-1-1-2-2\" data-name=\"products nav link\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"pharmacist consultation nav link\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"FAQ nav link\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"contact us nav link\" href=\"#\">اتصل بنا</a>\n</nav>\n<div class=\"bar-actions\" data-kid=\"1-1-1-3\" data-name=\"bar action buttons group\">\n<button class=\"pill-btn\" data-kid=\"1-1-1-3-1\" data-name=\"location selector button\" type=\"button\"><i class=\"icon-map-pin\" data-kid=\"1-1-1-3-1-1\" data-name=\"map pin icon\"></i>الحي السابع</button>\n<button aria-label=\"حسابك\" class=\"pill-btn icon-only\" data-kid=\"1-1-1-3-2\" data-name=\"user account button\" type=\"button\"><i class=\"icon-user-round\" data-kid=\"1-1-1-3-2-1\" data-name=\"user account icon\"></i></button>\n<button class=\"pill-btn cart-btn\" data-kid=\"1-1-1-3-3\" data-name=\"shopping cart button\" type=\"button\"><i class=\"icon-shopping-bag\" data-kid=\"1-1-1-3-3-1\" data-name=\"shopping bag icon\"></i>العربة<span class=\"cart-count num\" data-kid=\"1-1-1-3-3-2\" data-name=\"cart item count badge\">4</span></button>\n</div>\n</div>\n</header>\n<main class=\"wrap\" data-kid=\"1-2\" data-name=\"main content area\">\n<div class=\"steps\" data-kid=\"1-2-1\" data-name=\"checkout steps indicator\">\n<span class=\"step done\" data-kid=\"1-2-1-1\" data-name=\"completed cart step\"><span class=\"dot\" data-kid=\"1-2-1-1-1\" data-name=\"step check marker dot\"><i class=\"icon-check\" data-kid=\"1-2-1-1-1-1\" data-name=\"checkmark icon\"></i></span>العربة</span>\n<span class=\"sep\" data-kid=\"1-2-1-2\" data-name=\"step separator line\"></span>\n<span class=\"step current\" data-kid=\"1-2-1-3\" data-name=\"current order details step\"><span class=\"dot num\" data-kid=\"1-2-1-3-1\" data-name=\"current step number dot\">2</span>بيانات الطلب</span>\n</div>\n<h1 class=\"page-title\" data-kid=\"1-2-2\" data-name=\"page title heading\">إتمام الطلب</h1>\n<div class=\"cols\" data-kid=\"1-2-3\" data-name=\"two column checkout layout\">\n<div class=\"col-form\" data-kid=\"1-2-3-1\" data-name=\"left form column container\">\n<section class=\"panel\" data-kid=\"1-2-3-1-1\" data-name=\"customer details form panel\">\n<div class=\"panel-head\" data-kid=\"1-2-3-1-1-1\" data-name=\"customer details panel header\">\n<h2 data-kid=\"1-2-3-1-1-1-1\" data-name=\"customer details heading\">بيانات العميل</h2>\n</div>\n<div class=\"fields\" data-kid=\"1-2-3-1-1-2\" data-name=\"customer details form fields\">\n<label data-kid=\"1-2-3-1-1-2-1\" data-name=\"customer name field\">الاسم\n            <input data-kid=\"1-2-3-1-1-2-1-1\" data-name=\"customer name text input\" type=\"text\" value=\"منى عبد الرحمن\"/>\n</label>\n<label data-kid=\"1-2-3-1-1-2-2\" data-name=\"phone number field\">رقم الهاتف\n            <input data-kid=\"1-2-3-1-1-2-2-1\" data-name=\"phone number input\" type=\"tel\" value=\"0100 123 4567\"/>\n</label>\n<label class=\"full\" data-kid=\"1-2-3-1-1-2-3\" data-name=\"delivery address field\">عنوان التوصيل\n            <textarea data-kid=\"1-2-3-1-1-2-3-1\" data-name=\"delivery address textarea\" rows=\"3\">12 شارع مصطفى النحاس، الحي السابع، مدينة نصر</textarea>\n</label>\n</div>\n</section>\n<section class=\"panel\" data-kid=\"1-2-3-1-2\" data-name=\"pharmacy and delivery panel\">\n<div class=\"panel-head\" data-kid=\"1-2-3-1-2-1\" data-name=\"pharmacy panel header\">\n<h2 data-kid=\"1-2-3-1-2-1-1\" data-name=\"pharmacy panel heading\">الصيدلية والتوصيل</h2>\n<button class=\"link\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"change pharmacy link button\" type=\"button\">تغيير الصيدلية</button>\n</div>\n<div class=\"pharm\" data-kid=\"1-2-3-1-2-2\" data-name=\"pharmacy info card\">\n<span class=\"pharm-tile\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"pharmacy icon tile\"><i class=\"icon-store\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"store icon\"></i></span>\n<div data-kid=\"1-2-3-1-2-2-2\" data-name=\"pharmacy details block\">\n<b data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"pharmacy branch name\">فرع دواك - الحي السابع ٢</b>\n<span data-kid=\"1-2-3-1-2-2-2-2\" data-name=\"pharmacy location text\">الحي السابع، مدينة نصر</span>\n</div>\n<span class=\"stock-ok\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"stock availability badge\"><i class=\"icon-circle-check\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"circle check icon\"></i>المخزون متاح</span>\n</div>\n<div class=\"delivery\" data-kid=\"1-2-3-1-2-3\" data-name=\"delivery details grid\">\n<div data-kid=\"1-2-3-1-2-3-1\" data-name=\"delivery fee item\"><span data-kid=\"1-2-3-1-2-3-1-1\" data-name=\"delivery fee label\">رسوم التوصيل</span><strong class=\"num\" data-kid=\"1-2-3-1-2-3-1-2\" data-name=\"delivery fee amount\">30 ج.م</strong></div>\n<div data-kid=\"1-2-3-1-2-3-2\" data-name=\"estimated time item\"><span data-kid=\"1-2-3-1-2-3-2-1\" data-name=\"estimated time label\">الوقت المتوقع</span><strong class=\"num\" data-kid=\"1-2-3-1-2-3-2-2\" data-name=\"estimated time value\">90 دقيقة<small data-kid=\"1-2-3-1-2-3-2-2-1\" data-name=\"estimate qualifier text\">تقديري</small></strong></div>\n</div>\n<button class=\"confirm\" data-kid=\"1-2-3-1-2-4\" data-name=\"confirm order button\" type=\"button\">تأكيد الطلب</button>\n<p class=\"fine\" data-kid=\"1-2-3-1-2-5\" data-name=\"order disclaimer fine print\">طلب واحد من صيدلية واحدة. رسوم ووقت التوصيل بيانات تجريبية.</p>\n</section>\n</div>\n<aside class=\"summary\" data-kid=\"1-2-3-2\" data-name=\"order summary side panel\">\n<div class=\"sum-head\" data-kid=\"1-2-3-2-1\" data-name=\"order summary header\">\n<h2 data-kid=\"1-2-3-2-1-1\" data-name=\"order summary heading\">مراجعة الطلب</h2>\n<button class=\"link\" data-kid=\"1-2-3-2-1-2\" data-name=\"edit cart link button\" type=\"button\">تعديل العربة</button>\n</div>\n<ul class=\"items\" data-kid=\"1-2-3-2-2\" data-name=\"order items list\">\n<li data-kid=\"1-2-3-2-2-1\" data-name=\"medicine row item\">\n<div data-kid=\"1-2-3-2-2-1-1\" data-name=\"medicine info block\"><b data-kid=\"1-2-3-2-2-1-1-1\" data-name=\"medicine name\">بانادول</b><span class=\"sub\" data-kid=\"1-2-3-2-2-1-1-2\" data-name=\"medicine specification\">500 مج، أقراص، عبوة 20 قرص</span></div>\n<span class=\"q num\" data-kid=\"1-2-3-2-2-1-2\" data-name=\"item quantity\">×1</span>\n<span class=\"lt num\" data-kid=\"1-2-3-2-2-1-3\" data-name=\"item price\">35 ج.م</span>\n</li>\n<li data-kid=\"1-2-3-2-2-2\" data-name=\"medicine row item\">\n<div data-kid=\"1-2-3-2-2-2-1\" data-name=\"medicine info block\"><b data-kid=\"1-2-3-2-2-2-1-1\" data-name=\"medicine name\">بروفين</b><span class=\"sub\" data-kid=\"1-2-3-2-2-2-1-2\" data-name=\"medicine specification\">400 مج، أقراص</span></div>\n<span class=\"q num\" data-kid=\"1-2-3-2-2-2-2\" data-name=\"item quantity\">×1</span>\n<span class=\"lt num\" data-kid=\"1-2-3-2-2-2-3\" data-name=\"item price\">45 ج.م</span>\n</li>\n<li data-kid=\"1-2-3-2-2-3\" data-name=\"medicine row item\">\n<div data-kid=\"1-2-3-2-2-3-1\" data-name=\"medicine info block\"><b data-kid=\"1-2-3-2-2-3-1-1\" data-name=\"medicine name\">كونجستال</b><span class=\"sub\" data-kid=\"1-2-3-2-2-3-1-2\" data-name=\"medicine specification\">أقراص، عبوة أقراص</span></div>\n<span class=\"q num\" data-kid=\"1-2-3-2-2-3-2\" data-name=\"item quantity\">×1</span>\n<span class=\"lt num\" data-kid=\"1-2-3-2-2-3-3\" data-name=\"item price\">42 ج.م</span>\n</li>\n<li data-kid=\"1-2-3-2-2-4\" data-name=\"medicine row item\">\n<div data-kid=\"1-2-3-2-2-4-1\" data-name=\"medicine info block\"><b data-kid=\"1-2-3-2-2-4-1-1\" data-name=\"medicine name\">بيبانثين</b><span class=\"sub\" data-kid=\"1-2-3-2-2-4-1-2\" data-name=\"medicine specification\">5%، كريم</span></div>\n<span class=\"q num\" data-kid=\"1-2-3-2-2-4-2\" data-name=\"item quantity\">×1</span>\n<span class=\"lt num\" data-kid=\"1-2-3-2-2-4-3\" data-name=\"item price\">92 ج.م</span>\n</li>\n</ul>\n<p class=\"footer-note\" data-kid=\"1-2-3-2-3\" data-name=\"items count footer note\"><i class=\"icon-shopping-bag\" data-kid=\"1-2-3-2-3-1\" data-name=\"shopping bag icon\"></i>4 عناصر في العربة</p>\n<div class=\"totals\" data-kid=\"1-2-3-2-4\" data-name=\"order totals container\">\n<div data-kid=\"1-2-3-2-4-1\" data-name=\"subtotal row\"><span data-kid=\"1-2-3-2-4-1-1\" data-name=\"subtotal label\">قيمة المنتجات</span><strong class=\"num\" data-kid=\"1-2-3-2-4-1-2\" data-name=\"subtotal amount\">214 ج.م</strong></div>\n<div data-kid=\"1-2-3-2-4-2\" data-name=\"delivery fee row\"><span data-kid=\"1-2-3-2-4-2-1\" data-name=\"delivery fee label\">رسوم التوصيل</span><strong class=\"num\" data-kid=\"1-2-3-2-4-2-2\" data-name=\"delivery fee amount\">30 ج.م</strong></div>\n<div data-kid=\"1-2-3-2-4-3\" data-name=\"discount row\"><span data-kid=\"1-2-3-2-4-3-1\" data-name=\"discount label\">خصم</span><strong class=\"num\" data-kid=\"1-2-3-2-4-3-2\" data-name=\"discount amount\">0 ج.م</strong></div>\n<div class=\"grand\" data-kid=\"1-2-3-2-4-4\" data-name=\"grand total row\"><span data-kid=\"1-2-3-2-4-4-1\" data-name=\"grand total label\">الإجمالي</span><strong class=\"num\" data-kid=\"1-2-3-2-4-4-2\" data-name=\"grand total amount\">244 ج.م</strong></div>\n</div>\n<p class=\"sum-note\" data-kid=\"1-2-3-2-5\" data-name=\"pharmacy review note\"><i class=\"icon-shield-check\" data-kid=\"1-2-3-2-5-1\" data-name=\"shield check icon\"></i>يُراجع الصيدلي المخزون مرة أخرى عند تأكيد الطلب.</p>\n</aside>\n</div>\n</main>\n<footer class=\"foot\" data-kid=\"1-3\" data-name=\"site footer\">\n<div class=\"wrap foot-in\" data-kid=\"1-3-1\" data-name=\"footer inner container\">\n<span class=\"foot-brand\" data-kid=\"1-3-1-1\" data-name=\"footer brand block\"><img alt=\"شعار دواك\" data-kid=\"1-3-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>دواك</span>\n<div class=\"foot-links\" data-kid=\"1-3-1-2\" data-name=\"footer navigation links\">\n<a data-kid=\"1-3-1-2-1\" data-name=\"FAQ footer link\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-3-1-2-2\" data-name=\"privacy policy footer link\" href=\"#\">سياسة الخصوصية</a>\n<a data-kid=\"1-3-1-2-3\" data-name=\"terms of service footer link\" href=\"#\">الشروط والأحكام</a>\n<a data-kid=\"1-3-1-2-4\" data-name=\"contact us footer link\" href=\"#\">اتصل بنا</a>\n</div>\n<span data-kid=\"1-3-1-3\" data-name=\"footer disclaimer text\">الأسعار ووقت التوصيل تقديرية ويتم تأكيدها عند الطلب.</span>\n</div>\n</footer>\n</div>\n",
