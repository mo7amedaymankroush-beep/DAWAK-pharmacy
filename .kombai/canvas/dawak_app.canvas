        "h": 0
      },
      "html": "<div class=\"dawak\" data-kid=\"1\" data-name=\"RTL Arabic pharmacy page root\" dir=\"rtl\" lang=\"ar\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n.dawak{--ink:#122E29;--ink2:#3F5B54;--muted:#6C837C;--line:#E1EAE6;--line2:#D2E0DA;--brand:#0C5449;--brand-deep:#093B34;--accent:#12836B;--mint:#EAF4F0;--mint2:#F3F9F6;--amber:#E2952A;font-family:'Cairo',system-ui,-apple-system,sans-serif;background:linear-gradient(180deg,#EDF6F1 0,#F4F7F5 280px);color:var(--ink);min-height:100vh;padding-bottom:10px;-webkit-font-smoothing:antialiased}\n.dawak *{box-sizing:border-box}\n:where(.dawak) button,:where(.dawak) input{font:inherit;color:inherit}\n:where(.dawak) button{border:0;background:none;cursor:pointer}\n.dawak a{color:inherit;text-decoration:none}\n.ico{display:inline-block;font-style:normal;font-weight:400;line-height:1;font-size:16px}\n.page{max-width:1356px;margin:0 auto;padding:16px 42px 0}\n\n.topbar{height:82px;display:flex;align-items:center;gap:24px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:0 20px;box-shadow:0 6px 20px rgba(9,59,52,.05)}\n.brand{display:flex;align-items:center;gap:10px;flex:none}\n.brand img{width:44px;height:44px;border-radius:10px;object-fit:contain;mix-blend-mode:multiply}\n.brand-txt{display:grid;gap:1px;line-height:1.15}\n.brand-txt b{font-size:18px;font-weight:800;color:var(--brand-deep)}\n.brand-txt span{font-size:8.5px;font-weight:700;letter-spacing:1.5px;color:var(--muted)}\n.nav{flex:1;display:flex;align-items:center;justify-content:center;gap:20px}\n.nav a{font-size:12.5px;font-weight:700;color:#4D655F;padding:10px 2px;position:relative;white-space:nowrap}\n.nav a.on{color:var(--brand-deep)}\n.nav a.on::after{content:\"\";position:absolute;inset-inline:0;bottom:0;height:2px;border-radius:2px;background:var(--accent)}\n.acts{display:flex;gap:8px;flex:none}\n.btn-cart{height:40px;padding:0 14px;border:1px solid var(--line2);border-radius:10px;background:#fff;color:var(--brand);display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800}\n.btn-account{height:40px;padding:0 14px;border-radius:10px;background:var(--brand);color:#fff;display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:800}\n\n.crumb{margin:18px 0 10px}\n.back{display:inline-flex;align-items:center;gap:7px;height:36px;padding:0 12px;border:1px solid var(--line2);border-radius:9px;background:#fff;color:var(--brand);font-size:11.5px;font-weight:800}\n.back .ico{font-size:15px}\n\n.searchbar{display:grid;grid-template-columns:minmax(0,1fr) 180px 48px 104px;gap:10px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:8px;box-shadow:0 8px 22px rgba(9,59,52,.04)}\n.field{display:flex;align-items:center;gap:8px;height:48px;border:1px solid var(--line);border-radius:10px;padding:0 12px;background:#fff;min-width:0}\n.field.q .ico{font-size:16px;color:#7E958E;flex:none}\n.field.q input{border:0;outline:0;background:transparent;flex:1;min-width:0;font-size:12.5px;font-weight:600}\n.field.q input::placeholder{color:#96A8A2}\n.field.sel .ico{font-size:14px;color:#8C9F99}\n.fld{display:grid;flex:1;min-width:0;line-height:1.3}\n.fld-t{font-size:9px;font-weight:700;color:var(--muted)}\n.fld-v{font-size:12px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}\n.loc-btn{height:48px;border:1px solid var(--line);border-radius:10px;background:#fff;color:var(--brand);display:grid;place-items:center}\n.loc-btn .ico{font-size:17px}\n.btn-search{height:48px;border-radius:10px;background:var(--brand);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center}\n\n.product{margin-top:14px;display:flex;align-items:center;gap:16px;background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 18px;min-height:104px;box-shadow:0 8px 22px rgba(9,59,52,.04)}\n.p-thumb{width:64px;height:64px;border-radius:12px;background:var(--mint2);color:var(--brand);display:grid;place-items:center;font-size:28px;flex:none}\n.p-info{flex:1;min-width:0}\n.p-info h1{font-size:20px;font-weight:800;color:var(--brand-deep);margin:0 0 4px;letter-spacing:-.2px}\n.p-meta{font-size:12px;font-weight:700;color:#4E6A63;margin:0}\n.p-pack{font-size:11px;font-weight:600;color:var(--muted);margin:3px 0 0}\n.p-price{display:flex;align-items:baseline;gap:4px;margin-inline-end:8px}\n.p-price span{font-size:20px;font-weight:800;color:var(--brand-deep);font-variant-numeric:tabular-nums}\n.p-price em{font-style:normal;font-size:11px;font-weight:700;color:var(--muted)}\n.p-add{height:40px;padding:0 16px;border:1px solid #CBE1D8;border-radius:9px;background:var(--mint2);color:var(--brand);font-size:12px;font-weight:800;white-space:nowrap}\n\n.tabs{display:flex;gap:24px;border-bottom:1px solid var(--line);margin-top:16px}\n.tab{height:44px;display:inline-flex;align-items:center;font-size:13px;font-weight:800;color:#5A736C;border-bottom:2px solid transparent;margin-bottom:-1px;padding:0 2px;cursor:pointer}\n.tab.on{color:var(--brand-deep);border-color:var(--accent)}\n\n.bar{display:flex;align-items:center;gap:12px;margin:14px 0 12px;flex-wrap:wrap}\n.loc-chip{display:inline-flex;align-items:center;gap:8px;height:40px;padding:0 13px;border:1px solid #CFE6DD;border-radius:999px;background:#fff;color:var(--brand-deep);font-size:12px;font-weight:800}\n.loc-chip .ico{font-size:15px;color:var(--accent)}\n.link{background:none;border:0;color:var(--accent);font-size:11.5px;font-weight:800;padding:0}\n.count{font-size:12px;font-weight:800;color:#4E6A63;padding-inline-start:2px}\n.sort{margin-inline-start:auto;display:inline-flex;align-items:center;gap:4px;height:40px;padding:4px;border:1px solid var(--line);border-radius:10px;background:#fff}\n.sort button{height:32px;padding:0 12px;border:0;border-radius:7px;background:transparent;color:#5A736C;font-size:11.5px;font-weight:800}\n.sort button.on{background:var(--mint);color:var(--brand-deep)}\n\n.tbl{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;box-shadow:0 8px 24px rgba(9,59,52,.04)}\n.tbl-head,.row{display:grid;grid-template-columns:minmax(0,1fr) 110px 110px 132px 190px 156px;align-items:center;gap:12px;padding:0 18px}\n.tbl-head{height:40px;background:var(--mint2);border-bottom:1px solid var(--line);font-size:10.5px;font-weight:800;color:#5F7A72}\n.row{height:104px;border-bottom:1px solid #EDF3EF}\n.row:last-child{border-bottom:0}\n.ph-name{font-size:13.5px;font-weight:800;color:var(--brand-deep);margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.ph-area{display:flex;align-items:center;gap:4px;font-size:11px;font-weight:700;color:var(--muted);margin:4px 0 0}\n.ph-area .ico{font-size:13px}\n.cell-strong{font-size:13px;font-weight:800;color:var(--ink);margin:0;font-variant-numeric:tabular-nums}\n.cell-sub{font-size:10.5px;font-weight:700;color:var(--muted);margin:2px 0 0}\n.stock-off{color:#9C6A1C}\n.price-cell{display:flex;align-items:baseline;gap:4px;font-size:15px;font-weight:800;color:var(--brand-deep);margin:0;font-variant-numeric:tabular-nums}\n.price-cell span{font-size:10px;font-weight:700;color:var(--muted)}\n.deliv{display:grid;gap:1px}\n.deliv .a{font-size:12px;font-weight:800;color:var(--ink);margin:0;font-variant-numeric:tabular-nums}\n.deliv .b{font-size:10.5px;font-weight:700;color:var(--muted);margin:0}\n.demo{font-size:9px;font-weight:800;color:#8A9C96;border:1px solid var(--line);border-radius:4px;padding:1px 4px;width:fit-content;margin-top:3px}\n.act{display:grid;gap:5px}\n.primary{height:38px;border-radius:9px;background:var(--brand);color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center}\n.ghost{height:24px;color:#5A736C;font-size:11px;font-weight:800}\n.outline{height:34px;border:1px solid var(--line2);border-radius:9px;background:#fff;color:var(--brand);font-size:11.5px;font-weight:800}\n\n.group{display:flex;align-items:center;gap:8px;height:48px;padding:0 18px;background:#FAFCFB;border-bottom:1px solid var(--line);font-size:11.5px;font-weight:800;color:#4E6A63}\n.group .ico{font-size:14px;color:#7B928B}\n.row.off{background:#FCFDFC}\n.row.off .ph-name{color:#4E6A63}\n\n.foot{margin-top:24px;border-top:1px solid var(--line);padding:16px 0 20px;display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:11.5px;font-weight:700;color:var(--muted)}\n.links{display:flex;gap:18px}\n.links a{color:#4E6A63}\n</style>\n<div class=\"page\" data-kid=\"1-1\" data-name=\"page content container\">\n<header class=\"topbar\" data-kid=\"1-1-1\" data-name=\"sticky top navigation bar\">\n<div class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo block\">\n<img alt=\"شعار دواك\" data-kid=\"1-1-1-1-1\" data-name=\"pharmacy logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-txt\" data-kid=\"1-1-1-1-2\" data-name=\"brand text stack\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"brand Arabic name label\">دواك</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand English subtitle\">DAWAK PHARMACY</span></span>\n</div>\n<nav class=\"nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"nav link to home page\" href=\"#\">الرئيسية</a>\n<a class=\"on\" data-kid=\"1-1-1-2-2\" data-name=\"nav link to products (active)\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"nav link to pharmacist consultation\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"nav link to FAQ\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"nav link to contact\" href=\"#\">اتصل بنا</a>\n<a data-kid=\"1-1-1-2-6\" data-name=\"nav link to bookings\" href=\"#\">حجوزاتي</a>\n<a data-kid=\"1-1-1-2-7\" data-name=\"nav link to my orders\" href=\"#\">طلباتي</a>\n</nav>\n<div class=\"acts\" data-kid=\"1-1-1-3\" data-name=\"top bar action buttons group\">\n<button class=\"btn-cart\" data-kid=\"1-1-1-3-1\" data-name=\"shopping cart button with item count\"><i class=\"ico icon-shopping-cart\" data-kid=\"1-1-1-3-1-1\" data-name=\"shopping cart icon\"></i><span data-kid=\"1-1-1-3-1-2\" data-name=\"cart label with count\">العربة (2)</span></button>\n<button class=\"btn-account\" data-kid=\"1-1-1-3-2\" data-name=\"user account button\"><i class=\"ico icon-user-round\" data-kid=\"1-1-1-3-2-1\" data-name=\"user account icon\"></i><span data-kid=\"1-1-1-3-2-2\" data-name=\"account label text\">حسابي</span></button>\n</div>\n</header>\n<div class=\"crumb\" data-kid=\"1-1-2\" data-name=\"breadcrumb back control wrapper\"><button class=\"back\" data-kid=\"1-1-2-1\" data-name=\"back to all products button\"><i class=\"ico icon-arrow-right\" data-kid=\"1-1-2-1-1\" data-name=\"right arrow back icon\"></i>كل المنتجات</button></div>\n<section class=\"searchbar\" data-kid=\"1-1-3\" data-name=\"product search and filters bar\">\n<label class=\"field q\" data-kid=\"1-1-3-1\" data-name=\"search input field with icon\"><i class=\"ico icon-search\" data-kid=\"1-1-3-1-1\" data-name=\"search icon\"></i><input data-kid=\"1-1-3-1-2\" data-name=\"drug name search input\" placeholder=\"ابحث عن دواء آخر\"/></label>\n<div class=\"field sel\" data-kid=\"1-1-3-2\" data-name=\"area selection dropdown field\">\n<span class=\"fld\" data-kid=\"1-1-3-2-1\" data-name=\"area field display value\"><span class=\"fld-t\" data-kid=\"1-1-3-2-1-1\" data-name=\"area field label\">المنطقة</span><span class=\"fld-v\" data-kid=\"1-1-3-2-1-2\" data-name=\"selected area value\">الحي السابع</span></span>\n<i class=\"ico icon-chevron-down\" data-kid=\"1-1-3-2-2\" data-name=\"dropdown chevron icon\"></i>\n</div>\n<button aria-label=\"استخدم موقعي الحالي\" class=\"loc-btn\" data-kid=\"1-1-3-3\" data-name=\"use my current location button\"><i class=\"ico icon-crosshair\" data-kid=\"1-1-3-3-1\" data-name=\"crosshair location icon\"></i></button>\n<button class=\"btn-search\" data-kid=\"1-1-3-4\" data-name=\"primary search submit button\">ابحث</button>\n</section>\n<section class=\"product\" data-kid=\"1-1-4\" data-name=\"current product summary card\">\n<span class=\"p-thumb\" data-kid=\"1-1-4-1\" data-name=\"product thumbnail with pill icon\"><i class=\"ico icon-pill\" data-kid=\"1-1-4-1-1\" data-name=\"pill icon\"></i></span>\n<div class=\"p-info\" data-kid=\"1-1-4-2\" data-name=\"product title and metadata block\">\n<h1 data-kid=\"1-1-4-2-1\" data-name=\"product name headline\">بانادول</h1>\n<p class=\"p-meta\" data-kid=\"1-1-4-2-2\" data-name=\"product ingredients and form text\">باراسيتامول · 500 مج · أقراص</p>\n<p class=\"p-pack\" data-kid=\"1-1-4-2-3\" data-name=\"package size text\">عبوة 20 قرص</p>\n</div>\n<div class=\"p-price\" data-kid=\"1-1-4-3\" data-name=\"product price display\"><span data-kid=\"1-1-4-3-1\" data-name=\"product price value\">35</span><em data-kid=\"1-1-4-3-2\" data-name=\"currency unit label\">ج.م</em></div>\n<button class=\"p-add\" data-kid=\"1-1-4-4\" data-name=\"add to cart button\">أضف للعربة</button>\n</section>\n<div class=\"tabs\" data-kid=\"1-1-5\" data-name=\"tab navigation for product/branches\">\n<span class=\"tab on\" data-kid=\"1-1-5-1\" data-name=\"active tab for pharmacies list\">الصيدليات</span>\n<span class=\"tab\" data-kid=\"1-1-5-2\" data-name=\"tab for product info\">معلومات المنتج</span>\n</div>\n<div class=\"bar\" data-kid=\"1-1-6\" data-name=\"filter and sort toolbar\">\n<span class=\"loc-chip\" data-kid=\"1-1-6-1\" data-name=\"current location chip\"><i class=\"ico icon-crosshair\" data-kid=\"1-1-6-1-1\" data-name=\"location pin icon\"></i>موقعك الحالي · الحي السابع، مدينة نصر</span>\n<button class=\"link\" data-kid=\"1-1-6-2\" data-name=\"change area link-button\">تغيير المنطقة</button>\n<span class=\"count\" data-kid=\"1-1-6-3\" data-name=\"result count text\">3 فروع في منطقتك</span>\n<div class=\"sort\"