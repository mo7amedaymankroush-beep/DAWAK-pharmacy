      "created": "2026-11-10T19:31:22.682225+00:00",
      "modified": "2026-11-10T19:33:49.053114+00:00",
      "id": "var_8ed8b196340a",
      "contentHeight": 1000
    },
    "var_9167d475a74c": {
      "type": "variant",
      "label": "اتجاه ٢ · العربة وإتمام الطلب",
      "parentId": "var_0ea72859e066",
      "themeId": null,
      "rect": {
        "x": 2716.758703481392,
        "y": -95.07803121248499,
        "w": 1440,
        "h": 0
