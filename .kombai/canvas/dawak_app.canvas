      },
      "html": "<div class=\"dw\" data-kid=\"1\" data-name=\"RTL page layout container\" dir=\"rtl\">\n<style>\n@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap');\n@import url(\"https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css\");\n:root{\n  --green:#075e50;--green-dark:#06483f;--green-deep:#043e37;--bright:#16a783;\n  --mint:#e1f4ed;--mint-2:#f0faf6;--amber:#f5a12a;--ink:#123d38;--muted:#708783;\n  --border:#dcebe6;--line:#edf4f1;\n}\n*{box-sizing:border-box}\nbody{margin:0}\n.dw{background:#f6fbf9;color:var(--ink);font-family:'Cairo','Inter',sans-serif;font-size:14px;direction:rtl;min-height:100vh}\n.num{font-family:'Inter','Cairo',sans-serif;font-variant-numeric:tabular-nums}\n.wrap{max-width:1128px;margin:0 auto;padding:0 24px}\na{text-decoration:none;color:inherit}\nbutton{font:inherit;cursor:pointer;border:0;background:none;color:inherit}\ni{font-style:normal;line-height:1}\n\n/* top bar */\n.topbar{background:#fff;border-bottom:1px solid var(--border)}\n.bar{height:78px;display:flex;align-items:center;gap:18px}\n.brand{display:flex;align-items:center;gap:9px;flex:0 0 auto}\n.logo-img{width:42px;height:42px;object-fit:contain;mix-blend-mode:multiply;border-radius:10px}\n.brand-txt{display:flex;flex-direction:column;line-height:1.1}\n.brand-txt b{font-family:'Inter',sans-serif;font-size:17px;letter-spacing:.7px;color:var(--green-deep);font-weight:800}\n.brand-txt span{font-size:10.5px;color:var(--muted);font-weight:600;margin-top:3px}\n.links{display:flex;align-items:center;gap:19px;flex:1;padding-inline-start:14px}\n.links a{font-size:12.5px;font-weight:700;color:#456a62;padding:8px 0 6px;border-bottom:2px solid transparent}\n.links a.active{color:var(--green);border-bottom-color:var(--bright)}\n.bar-actions{display:flex;align-items:center;gap:8px}\n.pill-btn{display:inline-flex;align-items:center;gap:6px;height:38px;padding:0 11px;border:1px solid var(--border);border-radius:10px;background:#fff;color:var(--green-dark);font-size:11.5px;font-weight:700;white-space:nowrap}\n.pill-btn i{font-size:15px;color:#6e8d85}\n.icon-only{width:38px;padding:0;justify-content:center}\n.cart-btn{background:var(--green);border-color:var(--green);color:#fff}\n.cart-btn i{color:#bfe6d9}\n.cart-count{min-width:18px;height:18px;border-radius:9px;background:rgba(255,255,255,.18);display:inline-grid;place-items:center;font-size:10px;font-weight:700;padding:0 4px}\n\n/* back + identity */\n.backline{padding-top:16px}\n.back{display:inline-flex;align-items:center;gap:5px;font-size:12px;font-weight:700;color:#5c7c74}\n.back i{font-size:15px}\n.prod{display:grid;grid-template-columns:54px minmax(0,1fr) auto;align-items:center;gap:16px;margin-top:12px;padding:18px 20px;background:#fff;border:1px solid var(--border);border-radius:16px}\n.prod-tile{width:54px;height:54px;border-radius:13px;background:var(--mint-2);display:grid;place-items:center;color:var(--green);font-size:25px}\n.prod-id h1{margin:0;font-size:26px;font-weight:800;color:var(--green-deep);letter-spacing:-.2px}\n.chips{display:flex;flex-wrap:wrap;gap:6px;margin-top:7px}\n.chips span{display:inline-flex;align-items:center;height:24px;padding:0 9px;border:1px solid var(--border);border-radius:7px;background:#fbfefc;font-size:10.5px;font-weight:700;color:#5f7d75;white-space:nowrap}\n.chips span.no-rx{background:var(--mint);border-color:#c3e6da;color:var(--green-dark)}\n.prod-buy{display:flex;align-items:center;gap:16px;justify-self:end}\n.prod-price{display:flex;align-items:baseline;gap:4px;color:var(--green-deep)}\n.prod-price strong{font-size:24px;font-weight:800;line-height:1}\n.prod-price span{font-size:11.5px;font-weight:700;color:var(--muted)}\n.btn-outline{height:44px;padding:0 15px;border:1px solid #cfe6dd;border-radius:10px;background:#f4fbf8;color:var(--green);font-size:12.5px;font-weight:800;display:inline-flex;align-items:center;gap:6px;white-space:nowrap}\n.btn-outline i{font-size:15px}\n\n/* availability board */\n.board{margin-top:22px}\n.board-head{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:12px}\n.board-title{display:flex;align-items:baseline;gap:9px}\n.board-title h2{margin:0;font-size:19px;font-weight:800;color:var(--green-deep)}\n.board-title span{font-size:11.5px;color:var(--muted);font-weight:600}\n.tools{display:flex;align-items:center;gap:10px}\n.area-btn{display:inline-flex;align-items:center;gap:7px;height:40px;padding:0 12px;border:1px solid #cfe6dd;border-radius:10px;background:#fff;color:var(--green-dark);font-size:11.5px;font-weight:800;white-space:nowrap}\n.area-btn i{font-size:15px;color:var(--bright)}\n.area-btn i.chev{color:#7e9a92;font-size:13px}\n.sort{display:flex;align-items:center;gap:4px;height:40px;padding:4px;border:1px solid var(--border);border-radius:10px;background:#fff}\n.sort em{font-style:normal;font-size:10.5px;font-weight:700;color:#8aa29b;padding:0 6px 0 4px}\n.sort button{height:32px;padding:0 10px;border-radius:7px;font-size:11px;font-weight:700;color:#5f7d75;white-space:nowrap}\n.sort button.on{background:var(--mint);color:var(--green-deep)}\n\n.table{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:hidden}\n.thead,.row{display:grid;grid-template-columns:minmax(0,1fr) 136px 156px 168px 148px;gap:14px;align-items:center;padding:0 20px}\n.thead{height:40px;background:#fbfefc;border-bottom:1px solid var(--line);font-size:11px;font-weight:700;color:#8aa29b}\n.thead em{font-style:normal;font-size:10px;color:#a3b5af;margin-inline-start:4px}\n.row{min-height:104px;border-bottom:1px solid var(--line)}\n.row.off{background:#fdfefd}\n.ph b{display:block;font-size:13.5px;font-weight:800;color:var(--green-deep)}\n.ph span{display:block;font-size:11px;color:#7d948d;margin-top:3px}\n.ph button{font-size:10.5px;font-weight:800;color:var(--green);margin-top:7px;display:inline-flex;align-items:center;gap:4px}\n.ph button i{font-size:12px}\n.pprice{font-size:15px;font-weight:800;color:var(--green-dark);white-space:nowrap}\n.pprice small{font-size:10px;font-weight:700;color:var(--muted);margin-inline-start:2px}\n.stock{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:800}\n.stock i{font-size:15px;flex:0 0 auto}\n.stock em{font-style:normal;font-size:10.5px;font-weight:600;color:var(--muted);margin-inline-start:1px}\n.stock.ok{color:#16835f}\n.stock.out{color:#9a7b45}\n.ship{display:grid;gap:2px}\n.ship b{font-size:12.5px;font-weight:800;color:var(--green-dark);white-space:nowrap}\n.ship span{font-size:10.5px;color:#7d948d;font-weight:600}\n.row-actions{display:flex;align-items:center;justify-content:flex-end;gap:7px}\n.btn-order{height:40px;padding:0 14px;border-radius:9px;background:var(--green);color:#fff;font-size:12px;font-weight:800;white-space:nowrap}\n.btn-order:hover{background:var(--green-dark)}\n.btn-square{width:40px;height:40px;border:1px solid #cfe6dd;border-radius:9px;background:#f4fbf8;color:var(--green);display:grid;place-items:center;font-size:16px;flex:0 0 auto}\n.btn-off{height:40px;padding:0 12px;border:1px solid var(--border);border-radius:9px;background:#f7faf9;color:#93a8a1;font-size:11.5px;font-weight:800;cursor:not-allowed;white-space:nowrap}\n.other{border-top:1px solid var(--line);background:#fbfefc}\n.other button{width:100%;height:52px;display:flex;align-items:center;gap:8px;padding:0 20px;font-size:11.5px;font-weight:800;color:var(--green-dark)}\n.other i{font-size:15px;color:var(--bright)}\n.other .cnt{margin-inline-start:auto;font-size:11px;color:#8aa29b;font-weight:700}\n.note{display:flex;align-items:flex-start;gap:6px;margin:10px 2px 0;font-size:10.5px;line-height:1.7;color:#7d948d}\n.note i{font-size:13px;margin-top:2px;flex:0 0 auto;color:#9db3ac}\n\n/* product info */\n.details{margin-top:24px}\n.details h2{margin:0 0 12px;font-size:17px;font-weight:800;color:var(--green-deep)}\n.facts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--border);border:1px solid var(--border);border-radius:14px;overflow:hidden}\n.facts div{background:#fff;padding:13px 16px}\n.facts div.half{grid-column:span 2}\n.facts span{display:block;font-size:10.5px;font-weight:600;color:#8aa29b;margin-bottom:4px}\n.facts strong{font-size:12.5px;font-weight:800;color:var(--green-dark);line-height:1.7}\n\n/* footer */\n.foot{margin-top:24px;background:#fff;border-top:1px solid var(--border)}\n.foot-in{height:76px;display:flex;align-items:center;justify-content:space-between;gap:16px}\n.foot-links{display:flex;align-items:center;gap:20px}\n.foot a,.foot span{font-size:11.5px;color:#5f7d75;font-weight:600}\n.foot-brand{display:flex;align-items:center;gap:8px;color:var(--green-deep);font-weight:800;font-size:12.5px}\n.foot-brand img{width:26px;height:26px;object-fit:contain;mix-blend-mode:multiply}\n</style>\n<header class=\"topbar\" data-kid=\"1-1\" data-name=\"site header top bar\">\n<div class=\"wrap bar\" data-kid=\"1-1-1\" data-name=\"header content bar\">\n<a class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#\">\n<img alt=\"شعار دواك\" class=\"logo-img\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>\n<span class=\"brand-txt\" data-kid=\"1-1-1-1-2\" data-name=\"brand text block\"><b data-kid=\"1-1-1-1-2-1\" data-name=\"brand name DAWAK\">DAWAK</b><span data-kid=\"1-1-1-1-2-2\" data-name=\"brand tagline text\">دواك · صيدليتك أونلاين</span></span>\n</a>\n<nav class=\"links\" data-kid=\"1-1-1-2\" data-name=\"main navigation links\">\n<a data-kid=\"1-1-1-2-1\" data-name=\"home navigation link\" href=\"#\">الرئيسية</a>\n<a class=\"active\" data-kid=\"1-1-1-2-2\" data-name=\"active products navigation link\" href=\"#\">المنتجات</a>\n<a data-kid=\"1-1-1-2-3\" data-name=\"pharmacist consultation link\" href=\"#\">استشارة صيدلي</a>\n<a data-kid=\"1-1-1-2-4\" data-name=\"FAQ navigation link\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-1-1-2-5\" data-name=\"contact us navigation link\" href=\"#\">اتصل بنا</a>\n</nav>\n<div class=\"bar-actions\" data-kid=\"1-1-1-3\" data-name=\"header action buttons group\">\n<button class=\"pill-btn\" data-kid=\"1-1-1-3-1\" data-name=\"delivery area selector button\" type=\"button\"><i class=\"icon-map-pin\" data-kid=\"1-1-1-3-1-1\" data-name=\"map pin icon\"></i>الحي السابع</button>\n<button aria-label=\"حسابك\" class=\"pill-btn icon-only\" data-kid=\"1-1-1-3-2\" data-name=\"user account button\" type=\"button\"><i class=\"icon-user-round\" data-kid=\"1-1-1-3-2-1\" data-name=\"user account icon\"></i></button>\n<button class=\"pill-btn cart-btn\" data-kid=\"1-1-1-3-3\" data-name=\"shopping cart button\" type=\"button\"><i class=\"icon-shopping-bag\" data-kid=\"1-1-1-3-3-1\" data-name=\"shopping bag icon\"></i>العربة<span class=\"cart-count num\" data-kid=\"1-1-1-3-3-2\" data-name=\"cart item count badge\">4</span></button>\n</div>\n</div>\n</header>\n<main class=\"wrap\" data-kid=\"1-2\" data-name=\"main product page content\">\n<div class=\"backline\" data-kid=\"1-2-1\" data-name=\"back navigation row\">\n<button class=\"back\" data-kid=\"1-2-1-1\" data-name=\"back to products link\" type=\"button\"><i class=\"icon-chevron-right\" data-kid=\"1-2-1-1-1\" data-name=\"chevron right icon\"></i>المنتجات</button>\n</div>\n<section class=\"prod\" data-kid=\"1-2-2\" data-name=\"product overview card\">\n<span class=\"prod-tile\" data-kid=\"1-2-2-1\" data-name=\"product icon tile\"><i class=\"icon-pill\" data-kid=\"1-2-2-1-1\" data-name=\"pill icon\"></i></span>\n<div class=\"prod-id\" data-kid=\"1-2-2-2\" data-name=\"product identity block\">\n<h1 data-kid=\"1-2-2-2-1\" data-name=\"product name headline\">بانادول</h1>\n<div class=\"chips\" data-kid=\"1-2-2-2-2\" data-name=\"product attribute chips row\">\n<span data-kid=\"1-2-2-2-2-1\" data-name=\"active ingredient chip\">باراسيتامول</span>\n<span data-kid=\"1-2-2-2-2-2\" data-name=\"dosage chip\">500 مج</span>\n<span data-kid=\"1-2-2-2-2-3\" data-name=\"form chip\">أقراص</span>\n<span data-kid=\"1-2-2-2-2-4\" data-name=\"pack size chip\">عبوة 20 قرص</span>\n<span class=\"no-rx\" data-kid=\"1-2-2-2-2-5\" data-name=\"no-recipe-required chip\">بدون وصفة طبية</span>\n</div>\n</div>\n<div class=\"prod-buy\" data-kid=\"1-2-2-3\" data-name=\"product purchase block\">\n<span class=\"prod-price\" data-kid=\"1-2-2-3-1\" data-name=\"base price display\"><strong class=\"num\" data-kid=\"1-2-2-3-1-1\" data-name=\"price amount number\">35</strong><span data-kid=\"1-2-2-3-1-2\" data-name=\"currency label\">ج.م</span></span>\n<button class=\"btn-outline\" data-kid=\"1-2-2-3-2\" data-name=\"add to cart button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-2-2-3-2-1\" data-name=\"plus icon\"></i>أضف إلى العربة</button>\n</div>\n</section>\n<section class=\"board\" data-kid=\"1-2-3\" data-name=\"pharmacy availability section\">\n<div class=\"board-head\" data-kid=\"1-2-3-1\" data-name=\"availability board header\">\n<div class=\"board-title\" data-kid=\"1-2-3-1-1\" data-name=\"board title block\">\n<h2 data-kid=\"1-2-3-1-1-1\" data-name=\"board heading title\">الصيدليات</h2>\n<span data-kid=\"1-2-3-1-1-2\" data-name=\"branch count subtitle\">3 فروع في الحي السابع</span>\n</div>\n<div class=\"tools\" data-kid=\"1-2-3-1-2\" data-name=\"board filter tools\">\n<button class=\"area-btn\" data-kid=\"1-2-3-1-2-1\" data-name=\"delivery area dropdown button\" type=\"button\"><i class=\"icon-map-pin\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"map pin icon\"></i>الحي السابع، مدينة نصر<i class=\"icon-chevron-down chev\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"chevron down icon\"></i></button>\n<div class=\"sort\" data-kid=\"1-2-3-1-2-2\" data-name=\"sort toggle control\">\n<em data-kid=\"1-2-3-1-2-2-1\" data-name=\"sort label text\">ترتيب</em>\n<button class=\"on\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"active lowest price sort button\" type=\"button\">الأقل سعرًا</button>\n<button data-kid=\"1-2-3-1-2-2-3\" data-name=\"most stock sort button\" type=\"button\">الأكثر مخزونًا</button>\n</div>\n</div>\n</div>\n<div class=\"table\" data-kid=\"1-2-3-2\" data-name=\"availability results table\">\n<div class=\"thead\" data-kid=\"1-2-3-2-1\" data-name=\"table header row\">\n<span data-kid=\"1-2-3-2-1-1\" data-name=\"branch column header\">الفرع والمنطقة</span>\n<span data-kid=\"1-2-3-2-1-2\" data-name=\"price column header\">سعر الصيدلية</span>\n<span data-kid=\"1-2-3-2-1-3\" data-name=\"stock column header\">المخزون</span>\n<span data-kid=\"1-2-3-2-1-4\" data-name=\"delivery column header\">التوصيل<em data-kid=\"1-2-3-2-1-4-1\" data-name=\"delivery approximate note\">تقديري</em></span>\n<span data-kid=\"1-2-3-2-1-5\" data-name=\"actions column header placeholder\"></span>\n</div>\n<div class=\"row\" data-kid=\"1-2-3-2-2\" data-name=\"first pharmacy row\">\n<div class=\"ph\" data-kid=\"1-2-3-2-2-1\" data-name=\"pharmacy branch info cell\">\n<b data-kid=\"1-2-3-2-2-1-1\" data-name=\"branch name text\">فرع دواك - الحي السابع ٢</b>\n<span data-kid=\"1-2-3-2-2-1-2\" data-name=\"branch area text\">الحي السابع، مدينة نصر</span>\n<button data-kid=\"1-2-3-2-2-1-3\" data-name=\"address and hours toggle button\" type=\"button\"><i class=\"icon-map-pin\" data-kid=\"1-2-3-2-2-1-3-1\" data-name=\"map pin icon\"></i>العنوان وساعات العمل</button>\n</div>\n<span class=\"pprice\" data-kid=\"1-2-3-2-2-2\" data-name=\"branch price display\"><span class=\"num\" data-kid=\"1-2-3-2-2-2-1\" data-name=\"branch price amount\">34</span><small data-kid=\"1-2-3-2-2-2-2\" data-name=\"price currency unit\">ج.م</small></span>\n<span class=\"stock ok\" data-kid=\"1-2-3-2-2-3\" data-name=\"in-stock status display\"><i class=\"icon-package-check\" data-kid=\"1-2-3-2-2-3-1\" data-name=\"stock check icon\"></i>متوفر<em data-kid=\"1-2-3-2-2-3-2\" data-name=\"stock quantity note\">5 عبوات</em></span>\n<div class=\"ship\" data-kid=\"1-2-3-2-2-4\" data-name=\"shipping info cell\"><b class=\"num\" data-kid=\"1-2-3-2-2-4-1\" data-name=\"shipping fee amount\">30 ج.م</b><span data-kid=\"1-2-3-2-2-4-2\" data-name=\"estimated delivery time\">90 دقيقة</span></div>\n<div class=\"row-actions\" data-kid=\"1-2-3-2-2-5\" data-name=\"row action buttons\">\n<button class=\"btn-order\" data-kid=\"1-2-3-2-2-5-1\" data-name=\"order now button\" type=\"button\">اطلب الآن</button>\n<button aria-label=\"أضف إلى العربة\" class=\"btn-square\" data-kid=\"1-2-3-2-2-5-2\" data-name=\"add to cart icon button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-2-3-2-2-5-2-1\" data-name=\"plus icon\"></i></button>\n</div>\n</div>\n<div class=\"row\" data-kid=\"1-2-3-2-3\" data-name=\"second pharmacy row\">\n<div class=\"ph\" data-kid=\"1-2-3-2-3-1\" data-name=\"pharmacy branch info cell\">\n<b data-kid=\"1-2-3-2-3-1-1\" data-name=\"branch name text\">فرع دواك - الحي السابع</b>\n<span data-kid=\"1-2-3-2-3-1-2\" data-name=\"branch area text\">الحي السابع، مدينة نصر</span>\n<button data-kid=\"1-2-3-2-3-1-3\" data-name=\"address and hours toggle button\" type=\"button\"><i class=\"icon-map-pin\" data-kid=\"1-2-3-2-3-1-3-1\" data-name=\"map pin icon\"></i>العنوان وساعات العمل</button>\n</div>\n<span class=\"pprice\" data-kid=\"1-2-3-2-3-2\" data-name=\"branch price display\"><span class=\"num\" data-kid=\"1-2-3-2-3-2-1\" data-name=\"branch price amount\">37</span><small data-kid=\"1-2-3-2-3-2-2\" data-name=\"price currency unit\">ج.م</small></span>\n<span class=\"stock ok\" data-kid=\"1-2-3-2-3-3\" data-name=\"in-stock status display\"><i class=\"icon-package-check\" data-kid=\"1-2-3-2-3-3-1\" data-name=\"stock check icon\"></i>متوفر<em data-kid=\"1-2-3-2-3-3-2\" data-name=\"stock quantity note\">8 عبوات</em></span>\n<div class=\"ship\" data-kid=\"1-2-3-2-3-4\" data-name=\"shipping info cell\"><b class=\"num\" data-kid=\"1-2-3-2-3-4-1\" data-name=\"shipping fee amount\">30 ج.م</b><span data-kid=\"1-2-3-2-3-4-2\" data-name=\"estimated delivery time\">90 دقيقة</span></div>\n<div class=\"row-actions\" data-kid=\"1-2-3-2-3-5\" data-name=\"row action buttons\">\n<button class=\"btn-order\" data-kid=\"1-2-3-2-3-5-1\" data-name=\"order now button\" type=\"button\">اطلب الآن</button>\n<button aria-label=\"أضف إلى العربة\" class=\"btn-square\" data-kid=\"1-2-3-2-3-5-2\" data-name=\"add to cart icon button\" type=\"button\"><i class=\"icon-plus\" data-kid=\"1-2-3-2-3-5-2-1\" data-name=\"plus icon\"></i></button>\n</div>\n</div>\n<div class=\"row off\" data-kid=\"1-2-3-2-4\" data-name=\"out-of-stock pharmacy row\">\n<div class=\"ph\" data-kid=\"1-2-3-2-4-1\" data-name=\"pharmacy branch info cell\">\n<b data-kid=\"1-2-3-2-4-1-1\" data-name=\"branch name text\">فرع دواك - الحي السابع ٣</b>\n<span data-kid=\"1-2-3-2-4-1-2\" data-name=\"branch area text\">الحي السابع، مدينة نصر</span>\n<button data-kid=\"1-2-3-2-4-1-3\" data-name=\"address and hours toggle button\" type=\"button\"><i class=\"icon-map-pin\" data-kid=\"1-2-3-2-4-1-3-1\" data-name=\"map pin icon\"></i>العنوان وساعات العمل</button>\n</div>\n<span class=\"pprice\" data-kid=\"1-2-3-2-4-2\" data-name=\"branch price display\"><span class=\"num\" data-kid=\"1-2-3-2-4-2-1\" data-name=\"branch price amount\">39</span><small data-kid=\"1-2-3-2-4-2-2\" data-name=\"price currency unit\">ج.م</small></span>\n<span class=\"stock out\" data-kid=\"1-2-3-2-4-3\" data-name=\"out-of-stock status display\"><i class=\"icon-circle-minus\" data-kid=\"1-2-3-2-4-3-1\" data-name=\"circle minus icon\"></i>غير متوفر</span>\n<div class=\"ship\" data-kid=\"1-2-3-2-4-4\" data-name=\"shipping info cell\"><b data-kid=\"1-2-3-2-4-4-1\" data-name=\"unavailable fee placeholder\">—</b><span data-kid=\"1-2-3-2-4-4-2\" data-name=\"no stock delivery note\">لا يوجد مخزون</span></div>\n<div class=\"row-actions\" data-kid=\"1-2-3-2-4-5\" data-name=\"row action container\">\n<button class=\"btn-off\" data-kid=\"1-2-3-2-4-5-1\" data-name=\"disabled unavailable order button\" disabled=\"\" type=\"button\">غير متوفر</button>\n</div>\n</div>\n<div class=\"other\" data-kid=\"1-2-3-2-5\" data-name=\"other branches divider area\">\n<button data-kid=\"1-2-3-2-5-1\" data-name=\"view other branches button\" type=\"button\"><i class=\"icon-map\" data-kid=\"1-2-3-2-5-1-1\" data-name=\"map icon\"></i>فروع في مناطق أخرى<span class=\"cnt\" data-kid=\"1-2-3-2-5-1-2\" data-name=\"other branches count label\">4 فروع</span><i class=\"icon-chevron-down\" data-kid=\"1-2-3-2-5-1-3\" data-name=\"chevron down icon\"></i></button>\n</div>\n</div>\n<p class=\"note\" data-kid=\"1-2-3-3\" data-name=\"informational disclaimer note\"><i class=\"icon-info\" data-kid=\"1-2-3-3-1\" data-name=\"info icon\"></i>رسوم التوصيل والوقت المتوقع بيانات تجريبية لجميع الفروع، ويُعاد التحقق من المخزون عند تأكيد الطلب.</p>\n</section>\n<section class=\"details\" data-kid=\"1-2-4\" data-name=\"product details section\">\n<h2 data-kid=\"1-2-4-1\" data-name=\"product details heading\">معلومات المنتج</h2>\n<div class=\"facts\" data-kid=\"1-2-4-2\" data-name=\"facts grid container\">\n<div data-kid=\"1-2-4-2-1\" data-name=\"active ingredient fact block\"><span data-kid=\"1-2-4-2-1-1\" data-name=\"active ingredient label\">المادة الفعالة</span><strong data-kid=\"1-2-4-2-1-2\" data-name=\"active ingredient value\">باراسيتامول</strong></div>\n<div data-kid=\"1-2-4-2-2\" data-name=\"dosage fact block\"><span data-kid=\"1-2-4-2-2-1\" data-name=\"dosage label\">التركيز</span><strong data-kid=\"1-2-4-2-2-2\" data-name=\"dosage value\">500 مج</strong></div>\n<div data-kid=\"1-2-4-2-3\" data-name=\"form fact block\"><span data-kid=\"1-2-4-2-3-1\" data-name=\"form label\">الشكل</span><strong data-kid=\"1-2-4-2-3-2\" data-name=\"form value\">أقراص</strong></div>\n<div data-kid=\"1-2-4-2-4\" data-name=\"pack size fact block\"><span data-kid=\"1-2-4-2-4-1\" data-name=\"pack size label\">العبوة</span><strong data-kid=\"1-2-4-2-4-2\" data-name=\"pack size value\">20 قرص</strong></div>\n<div class=\"half\" data-kid=\"1-2-4-2-5\" data-name=\"description fact block\"><span data-kid=\"1-2-4-2-5-1\" data-name=\"description label\">الوصف</span><strong data-kid=\"1-2-4-2-5-2\" data-name=\"description value\">مسكن للألم وخافض للحرارة.</strong></div>\n<div class=\"half\" data-kid=\"1-2-4-2-6\" data-name=\"usage instructions fact block\"><span data-kid=\"1-2-4-2-6-1\" data-name=\"usage label\">طريقة الاستخدام</span><strong data-kid=\"1-2-4-2-6-2\" data-name=\"usage value\">وفق النشرة وتعليمات الصيدلي.</strong></div>\n</div>\n</section>\n</main>\n<footer class=\"foot\" data-kid=\"1-3\" data-name=\"page footer\">\n<div class=\"wrap foot-in\" data-kid=\"1-3-1\" data-name=\"footer content row\">\n<span class=\"foot-brand\" data-kid=\"1-3-1-1\" data-name=\"footer brand block\"><img alt=\"شعار دواك\" data-kid=\"1-3-1-1-1\" data-name=\"footer brand logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/public/dawak-logo.jpg\"/>دواك</span>\n<div class=\"foot-links\" data-kid=\"1-3-1-2\" data-name=\"footer links group\">\n<a data-kid=\"1-3-1-2-1\" data-name=\"footer FAQ link\" href=\"#\">الأسئلة الشائعة</a>\n<a data-kid=\"1-3-1-2-2\" data-name=\"footer privacy policy link\" href=\"#\">سياسة الخصوصية</a>\n<a data-kid=\"1-3-1-2-3\" data-name=\"footer terms link\" href=\"#\">الشروط والأحكام</a>\n<a data-kid=\"1-3-1-2-4\" data-name=\"footer contact link\" href=\"#\">اتصل بنا</a>\n</div>\n<span data-kid=\"1-3-1-3\" data-name=\"footer pricing disclaimer text\">الأسعار ووقت التوصيل تقديرية ويتم تأكيدها عند الطلب.</span>\n</div>\n</footer>\n</div>\n",
