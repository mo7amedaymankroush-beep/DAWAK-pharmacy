t text group\"><h3 data-kid=\"1-1-2-2-1-5-1-2-1\" data-name=\"product name Vitamin C\">فيتامين سي</h3><p data-kid=\"1-1-2-2-1-5-1-2-2\" data-name=\"product description Vitamin C\">فيتامين C · 1000 مج · أقراص</p></div>\n</div>\n<span class=\"unit\" data-kid=\"1-1-2-2-1-5-2\" data-name=\"unit price value\">124 ج.م</span>\n<div class=\"qty\" data-kid=\"1-1-2-2-1-5-3\" data-name=\"quantity stepper\"><button aria-label=\"تقليل الكمية\" data-kid=\"1-1-2-2-1-5-3-1\" data-name=\"decrease quantity button\"><i class=\"ico icon-minus\" data-kid=\"1-1-2-2-1-5-3-1-1\" data-name=\"minus icon\"></i></button><span data-kid=\"1-1-2-2-1-5-3-2\" data-name=\"quantity value display\">1</span><button aria-label=\"زيادة الكمية\" data-kid=\"1-1-2-2-1-5-3-3\" data-name=\"increase quantity button\"><i class=\"ico icon-plus\" data-kid=\"1-1-2-2-1-5-3-3-1\" data-name=\"plus icon\"></i></button></div>\n<span class=\"line\" data-kid=\"1-1-2-2-1-5-4\" data-name=\"line total value\">124 ج.م</span>\n<button aria-label=\"حذف فيتامين سي\" class=\"del\" data-kid=\"1-1-2-2-1-5-5\" data-name=\"remove item button\"><i class=\"ico icon-trash-2\" data-kid=\"1-1-2-2-1-5-5-1\" data-name=\"trash icon\"></i></button>\n</div>\n</section>\n<aside class=\"panel\" data-kid=\"1-1-2-2-2\" data-name=\"delivery details panel\">\n<h2 data-kid=\"1-1-2-2-2-1\" data-name=\"delivery panel heading\">بيانات التوصيل</h2>\n<div class=\"two\" data-kid=\"1-1-2-2-2-2\" data-name=\"two-column name and phone fields\">\n<div class=\"f\" data-kid=\"1-1-2-2-2-2-1\" data-name=\"full name field\"><label data-kid=\"1-1-2-2-2-2-1-1\" data-name=\"label full name\">الاسم بالكامل</label><input data-kid=\"1-1-2-2-2-2-1-2\" data-name=\"full name input field\" value=\"مريم عبد الرحمن\"/></div>\n<div class=\"f\" data-kid=\"1-1-2-2-2-2-2\" data-name=\"phone number field\"><label data-kid=\"1-1-2-2-2-2-2-1\" data-name=\"label phone number\">رقم الموبايل</label><input data-kid=\"1-1-2-2-2-2-2-2\" data-name=\"phone number input field\" value=\"010 2